{
  "$meta": { "name": "Bob Pro Design Tokens", "version": "1.0", "frozen": true },
  "neutrals": {
    "ink900": "#0C2340", "ink800": "#0F2235", "ink600": "#1B3A63",
    "slate500": "#5B6B7B", "slate400": "#8A99A8", "slate300": "#A9B4C0",
    "line": "#E0E6EE", "lineSoft": "#F1F4F7", "bg": "#EFF2F7", "surface": "#FFFFFF"
  },
  "semantic": {
    "success": "#0E7C5A", "successBg": "#EAF2EC", "successOnDark": "#6EE7B7",
    "warning": "#C77A12", "warningBg": "#FBF0DF",
    "danger": "#C8463C", "dangerBg": "#FBEAE8", "dangerVivid": "#E5544B",
    "b2b": "#1B3A63", "b2bBg": "#E6EDF6",
    "b2g": "#4338CA", "b2gBg": "#EDEAFE",
    "particulier": "#C77A12", "particulierBg": "#FBF0DF",
    "ai": "#4338CA", "aiBg": "#F1EBFA", "aiInk": "#4B2A86"
  },
  "themes": {
    "marine":   { "d1": "#0C2340", "d2": "#122E52", "d3": "#163763", "ink": "#0C2340", "ink2": "#1B3A63" },
    "foret":    { "d1": "#0A3A2B", "d2": "#0E5A43", "d3": "#117A5A", "ink": "#0C4A37", "ink2": "#0E6B4F" },
    "graphite": { "d1": "#15181E", "d2": "#242A33", "d3": "#36404E", "ink": "#1B2028", "ink2": "#2C333F" },
    "indigo":   { "d1": "#272363", "d2": "#3A36A0", "d3": "#4F46E5", "ink": "#312C8A", "ink2": "#4338CA" }
  },
  "defaultTheme": "marine",
  "gradients": {
    "header": "linear-gradient(168deg, {d1} 0%, {d2} 58%, {d3} 100%)",
    "hero": "linear-gradient(150deg, {d1}, {d3})",
    "fab": "linear-gradient(145deg, {ink2}, {d1})",
    "cta": "linear-gradient(135deg, {d1}, {ink2})"
  },
  "fonts": { "display": "Schibsted Grotesk", "text": "Hanken Grotesk" },
  "type": {
    "heroNum":   { "family": "display", "size": 42,   "weight": 800, "tracking": -1 },
    "pageTitle": { "family": "display", "size": 30,   "weight": 700, "tracking": -0.5 },
    "screenH1":  { "family": "display", "size": 27,   "weight": 700, "tracking": -0.4 },
    "section":   { "family": "display", "size": 17,   "weight": 700 },
    "cardTitle": { "family": "display", "size": 16,   "weight": 700 },
    "bigNum":    { "family": "display", "size": 21,   "weight": 800 },
    "body":      { "family": "text",    "size": 14.5, "weight": 500 },
    "sub":       { "family": "text",    "size": 13.5, "weight": 500 },
    "button":    { "family": "text",    "size": 16,   "weight": 700 },
    "label":     { "family": "text",    "size": 13,   "weight": 600 },
    "eyebrow":   { "family": "text",    "size": 12,   "weight": 700, "tracking": 0.4, "uppercase": true },
    "meta":      { "family": "text",    "size": 12,   "weight": 600 }
  },
  "radius": { "sm": 8, "chip": 11, "squircle": 14, "card": 16, "cardLg": 18, "cardXl": 22, "pill": 999 },
  "shadow": {
    "e0": "0 1px 2px rgba(13,38,68,.05)",
    "e1": "0 1px 2px rgba(13,38,68,.04), 0 6px 16px rgba(13,38,68,.06)",
    "e2": "0 1px 2px rgba(13,38,68,.04), 0 8px 22px rgba(13,38,68,.06)",
    "e3": "0 14px 34px rgba(12,35,64,.3)"
  },
  "space": [0, 4, 7, 8, 11, 12, 14, 16, 18, 20, 22, 26, 28, 54],
  "frame": { "width": 402, "height": 874, "safeTop": 54 },
  "userSettings": {
    "personality": ["Pote", "Pro", "Direct"],
    "density": ["Cockpit", "Zen"],
    "brand": ["Marine", "Forêt", "Graphite", "Indigo"]
  }
}
