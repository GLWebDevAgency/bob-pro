# syntax=docker/dockerfile:1
# Scanner one-shot des archives légales historiques. Cette image est déployée sur un service
# Railway isolé : aucun PDF/XML de production ne transite par GitHub et l'API n'embarque pas Java.

FROM node:22.18.0-slim AS base
ENV PNPM_HOME="/pnpm" PATH="/pnpm:$PATH"
RUN apt-get update -y && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/* \
  && corepack enable && corepack prepare pnpm@9.12.0 --activate
WORKDIR /repo

FROM base AS build
COPY . .
RUN pnpm install --frozen-lockfile --filter "@bob/api..."
RUN pnpm --filter "@bob/api..." run build

# Les dépendances normatives sont récupérées uniquement pendant le build, sans aucun secret ni
# document. Chaque archive et chaque fichier de règles est vérifié par SHA-256 avant d'entrer dans
# l'image finale ; le job de production n'a donc pas besoin d'un accès réseau sortant général.
FROM base AS validators
RUN apt-get update -y && apt-get install -y --no-install-recommends curl unzip \
  && rm -rf /var/lib/apt/lists/*
COPY .github/scripts/certify-facturx-fnfe.sh /repo/.github/scripts/certify-facturx-fnfe.sh
RUN mkdir -p /opt/bob-validators \
  && curl -fsSL --retry 3 --retry-all-errors --retry-delay 3 --connect-timeout 20 --max-time 180 \
       -o /opt/bob-validators/Mustang-CLI-2.24.0.jar \
       https://repo1.maven.org/maven2/org/mustangproject/Mustang-CLI/2.24.0/Mustang-CLI-2.24.0.jar \
  && printf '%s  %s\n' \
       e4904ffa0afdce3f5836dceb927c440a05ed5d60386fdd37e17a4b2f7652edbf \
       /opt/bob-validators/Mustang-CLI-2.24.0.jar | sha256sum -c - \
  && FNFE_PREPARE_ONLY=true bash /repo/.github/scripts/certify-facturx-fnfe.sh \
       /dev/null /tmp/fnfe-prepare /opt/bob-validators/fnfe-bundle \
  && rm -rf /tmp/fnfe-prepare

FROM base AS runner
ENV NODE_ENV="production" \
    HOME="/work" \
    DOCUMENT_ARCHIVE_MUSTANG_JAR="/opt/bob-validators/Mustang-CLI-2.24.0.jar" \
    DOCUMENT_ARCHIVE_FNFE_BUNDLE="/opt/bob-validators/fnfe-bundle" \
    DOCUMENT_ARCHIVE_VALIDATOR_SANDBOX="/usr/bin/bwrap"
RUN apt-get update -y && apt-get install -y --no-install-recommends \
    default-jre-headless libxml2-utils unzip bubblewrap \
  && rm -rf /var/lib/apt/lists/* \
  && groupadd --gid 10001 bob-archive-audit \
  && useradd --uid 10001 --gid 10001 --home-dir /work --shell /usr/sbin/nologin \
       bob-archive-audit \
  && install -d -o 10001 -g 10001 -m 0700 /work
COPY --from=build /repo /repo
COPY --from=validators /opt/bob-validators /opt/bob-validators
RUN <<'EOF'
install -o root -g root -m 0755 /dev/stdin /usr/local/bin/bob-archive-audit-entrypoint <<'SCRIPT'
#!/bin/sh
set -eu
umask 077
. /repo/apps/api/scripts/lib/preserve-cleanup-status.sh

if [ "$(id -u)" != "10001" ] || [ "$(id -g)" != "10001" ] || \
   [ "$(id -un)" != "bob-archive-audit" ]; then
  echo "Archive audit role identity is invalid." >&2
  exit 70
fi

outer_probe="/bob-archive-rootfs-probe-$$"
if touch "$outer_probe" 2>/dev/null; then
  rm -f "$outer_probe"
  echo "Archive audit root filesystem is writable by the runtime role." >&2
  exit 70
fi

runtime_probe_directory="$(mktemp -d /work/archive-runtime-probe.XXXXXX)"
cleanup_runtime_probe() {
  rm -rf "$runtime_probe_directory"
}
cleanup_archive_entrypoint_on_exit() {
  original_status=$?
  trap - EXIT HUP INT TERM
  preserve_exit_status_after_cleanup "$original_status" cleanup_runtime_probe
}
trap cleanup_archive_entrypoint_on_exit EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
touch "$runtime_probe_directory/workdir-writable"
cleanup_runtime_probe
trap - EXIT HUP INT TERM

# Railway interdit les namespaces non privilégiés. Le smoke Bubblewrap reste obligatoire, mais il
# est exécuté paresseusement par le validateur juste avant la première paire Factur-X. Un inventaire
# vide/B2C n'exécute aucun binaire tiers ; une paire professionnelle reste fail-closed si le sandbox
# n'est pas disponible.
cd /repo
exec sh apps/api/scripts/run-document-archive-audit-job.sh
SCRIPT
EOF
WORKDIR /repo
USER bob-archive-audit:bob-archive-audit
CMD ["/usr/local/bin/bob-archive-audit-entrypoint"]
