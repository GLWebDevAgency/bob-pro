// Bob Pro — schéma Postgres (source de vérité financière). Aligné sur le blueprint §6.2.
// IDs applicatifs (String) fournis par le domaine (UuidGenerator / fixtures).

datasource db {
  provider  = "postgresql"
  // Runtime de l'app : rôle applicatif « bob_app » NON-superuser (soumis à FORCE RLS = isolation multi-tenant réelle).
  url       = env("DATABASE_URL")
  // Migrations / seed : rôle privilégié « postgres ». Requis par Prisma CLI dès que directUrl est déclaré.
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum LegalForm {
  EI
  EURL
  SASU
  SARL
  SAS
  micro
}

enum VatRegime {
  franchise
  reel_simpl
  reel_normal
}

enum CustomerType {
  b2c
  b2b
  b2g
}

enum DocKind {
  quote
  invoice
  deposit_invoice
  credit_note
  situation
}

enum QuoteStatus {
  draft
  sent
  viewed
  signed
  refused
  expired
}

enum InvoiceStatus {
  draft
  issued
  partially_paid
  paid
  late
  cancelled
}

enum LineCategory {
  labor
  supply
  travel
  disbursement
  subscription
}

enum PaymentMethod {
  card
  transfer
  cash
}

enum PublicAccessScope {
  quote_signature
}

enum PublicAccessResourceType {
  quote
}

enum StoredDocumentKind {
  invoice_pdf
  quote_pdf
  facturx_xml
  expense_receipt
  signed_quote
  other
}

enum StoredDocumentOrigin {
  generated
  uploaded
  ocr
}

enum StoredDocumentStatus {
  active
  deleted
}

enum StoredDocumentLinkedEntityType {
  invoice
  quote
  expense
  chantier
  company
}

enum DocumentArchiveJobStatus {
  pending
  done
  failed
}

enum NotificationJobStatus {
  pending
  done
  failed
}

enum AgentJournalPhase {
  planned
  denied
  executed
  failed
}

enum AgentComplianceLevel {
  low
  medium
  high
}

model Company {
  id                  String               @id
  name                String
  legalForm           LegalForm
  siren               String               @db.Char(9)
  siret               String               @unique @db.Char(14)
  apeCode             String?
  trade               String
  vatRegime           VatRegime
  rcsOrRm             String?
  addrLine1           String
  addrZip             String
  addrCity            String
  iban                String?
  bic                 String?
  insurerName         String?
  policyNo            String?
  coverage            String?
  policyExpiresAt     DateTime?
  customers           Customer[]
  quotes              Quote[]
  invoices            Invoice[]
  payments            Payment[]
  publicAccessTokens  PublicAccessToken[]
  expenses            Expense[]
  documents           StoredDocument[]
  documentArchiveJobs DocumentArchiveJob[]
  notificationJobs    NotificationJob[]
  agentJournalEntries AgentJournalEntry[]
  counters            DocumentCounter[]

  @@map("companies")
}

model Customer {
  id                  String       @id
  companyId           String
  company             Company      @relation(fields: [companyId], references: [id])
  type                CustomerType
  name                String
  siren               String?      @db.Char(9)
  isInternational     Boolean      @default(false)
  addrLine1           String
  addrZip             String
  addrCity            String
  email               String?
  phone               String?
  ptLabel             String?
  score               Int          @default(0)
  avgDelayDays        Int          @default(0)
  outstanding         Int          @default(0)
  isSubcontractingBtp Boolean      @default(false)

  @@index([companyId])
  @@index([companyId, type])
  @@map("customers")
}

model Quote {
  id             String      @id
  companyId      String
  company        Company     @relation(fields: [companyId], references: [id])
  customerId     String
  status         QuoteStatus @default(draft)
  number         String?
  validUntil     DateTime?
  depositPct     Int?
  signerName     String?
  signedAt       DateTime?
  totalsHt       Int         @default(0)
  totalsVat      Int         @default(0)
  totalsTtc      Int         @default(0)
  totalsNetToPay Int         @default(0)
  vatByRate      Json        @default("{}")
  lines          LineItem[]  @relation("QuoteLines")

  @@unique([companyId, number], name: "uniq_quote_number")
  @@index([companyId, status])
  @@map("quotes")
}

model Invoice {
  id             String        @id
  companyId      String
  company        Company       @relation(fields: [companyId], references: [id])
  customerId     String
  kind           DocKind
  status         InvoiceStatus @default(draft)
  number         String?
  issuedAt       DateTime?
  dueAt          DateTime?
  parentQuoteId  String?
  depositPct     Int?
  paidCents      Int           @default(0)
  totalsHt       Int           @default(0)
  totalsVat      Int           @default(0)
  totalsTtc      Int           @default(0)
  totalsNetToPay Int           @default(0)
  vatByRate      Json          @default("{}")
  legalMentions  String[]      @default([])
  lines          LineItem[]    @relation("InvoiceLines")
  payments       Payment[]

  @@unique([companyId, number], name: "uniq_invoice_number")
  @@unique([companyId, parentQuoteId, kind], name: "uniq_invoice_parent_quote_kind")
  @@index([companyId, status])
  @@index([dueAt])
  @@map("invoices")
}

model LineItem {
  id          String       @id @default(uuid())
  quoteId     String?
  quote       Quote?       @relation("QuoteLines", fields: [quoteId], references: [id])
  invoiceId   String?
  invoice     Invoice?     @relation("InvoiceLines", fields: [invoiceId], references: [id])
  position    Int
  label       String
  category    LineCategory
  qty         Decimal      @db.Decimal(12, 3)
  unit        String?
  unitPriceHt Int
  vatRate     Decimal      @db.Decimal(4, 2)

  @@index([quoteId])
  @@index([invoiceId])
  @@map("line_items")
}

model Payment {
  id             String        @id
  companyId      String
  company        Company       @relation(fields: [companyId], references: [id])
  invoiceId      String
  invoice        Invoice       @relation(fields: [invoiceId], references: [id])
  amount         Int
  method         PaymentMethod
  receivedAt     DateTime
  idempotencyKey String?

  @@unique([companyId, idempotencyKey])
  @@index([invoiceId])
  @@map("payments")
}

model PublicAccessToken {
  id           String                   @id
  companyId    String
  company      Company                  @relation(fields: [companyId], references: [id])
  tokenHash    String                   @unique
  resourceType PublicAccessResourceType
  resourceId   String
  scope        PublicAccessScope
  expiresAt    DateTime
  revokedAt    DateTime?
  lastUsedAt   DateTime?
  createdAt    DateTime                 @default(now())

  @@index([companyId, resourceType, resourceId, scope])
  @@map("public_access_tokens")
}

model Expense {
  id            String   @id
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  supplierName  String
  supplierSiren String?  @db.Char(9)
  documentDate  String
  totalTtcCents Int
  totalHtCents  Int?
  vatCents      Int?
  vatRatePct    Float?
  category      String
  status        String   @default("to_pay")
  source        String   @default("manual")
  createdAt     DateTime @default(now())

  @@index([companyId])
  @@map("expenses")
}

model StoredDocument {
  id               String                          @id
  companyId        String
  company          Company                         @relation(fields: [companyId], references: [id])
  kind             StoredDocumentKind
  origin           StoredDocumentOrigin
  status           StoredDocumentStatus            @default(active)
  filename         String
  mimeType         String
  byteSize         Int
  sha256           String                          @db.Char(64)
  storageKey       String                          @unique
  linkedEntityType StoredDocumentLinkedEntityType?
  linkedEntityId   String?
  documentDate     String?
  issuedAt         String?
  createdAt        DateTime
  createdBy        String?
  retentionUntil   String
  deletedAt        DateTime?
  versions         StoredDocumentVersion[]

  @@index([companyId, kind])
  @@index([companyId, linkedEntityType, linkedEntityId])
  @@index([companyId, retentionUntil])
  @@map("documents")
}

model StoredDocumentVersion {
  id         String         @id
  documentId String
  document   StoredDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version    Int
  storageKey String         @unique
  sha256     String         @db.Char(64)
  mimeType   String
  byteSize   Int
  createdAt  DateTime
  reason     String

  @@unique([documentId, version])
  @@index([documentId])
  @@map("document_versions")
}

model DocumentArchiveJob {
  id            String                   @id
  companyId     String
  company       Company                  @relation(fields: [companyId], references: [id])
  invoiceId     String
  reason        String                   @default("invoice-issued")
  status        DocumentArchiveJobStatus @default(pending)
  attempts      Int                      @default(0)
  nextAttemptAt DateTime
  lastError     String?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  @@unique([companyId, invoiceId, reason], name: "uniq_document_archive_job")
  @@index([companyId, status, nextAttemptAt])
  @@map("document_archive_jobs")
}

model NotificationJob {
  id            String                @id
  companyId     String
  company       Company               @relation(fields: [companyId], references: [id])
  kind          String
  dedupeKey     String
  channel       String
  recipient     String
  subject       String
  payload       Json?
  status        NotificationJobStatus @default(pending)
  attempts      Int                   @default(0)
  nextAttemptAt DateTime
  lastError     String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@unique([companyId, kind, dedupeKey], name: "uniq_notification_job")
  @@index([companyId, status, nextAttemptAt])
  @@map("notification_jobs")
}

// Journal append-only des actions agentiques exécutées par Bob.
// Une entrée = une intention/audit factuel ; l'application n'expose ni update ni delete.
model AgentJournalEntry {
  id           String               @id
  companyId    String
  company      Company              @relation(fields: [companyId], references: [id])
  runId        String
  seq          Int
  at           DateTime
  phase        AgentJournalPhase
  tool         String
  label        String
  args         Json
  mutating     Boolean
  outbound     Boolean
  compliance   AgentComplianceLevel
  reason       String?
  resultDigest String?
  createdAt    DateTime             @default(now())

  @@unique([companyId, runId, seq], name: "uniq_agent_journal_seq")
  @@index([companyId, runId])
  @@index([companyId, at])
  @@map("agent_journal_entries")
}

// Numérotation sans trou : INSERT ... ON CONFLICT DO UPDATE +1 RETURNING (atomique).
model DocumentCounter {
  companyId  String
  company    Company @relation(fields: [companyId], references: [id])
  counterKey String
  fiscalYear Int
  nextValue  Int     @default(1)

  @@id([companyId, counterKey, fiscalYear])
  @@map("document_counters")
}
