model Company {
  id                                          String                                       @id
  name                                        String
  legalForm                                   LegalForm
  siren                                       String                                       @db.Char(9)
  siret                                       String                                       @unique @db.Char(14)
  apeCode                                     String?
  trade                                       String
  vatRegime                                   VatRegime
  /// Clientèle principale confirmée par le propriétaire. NULL tant que la question n'a pas été répondue.
  customerPortfolio                           CustomerPortfolio?
  rcsOrRm                                     String?
  addrLine1                                   String
  addrZip                                     String
  addrCity                                    String
  tvaIntracom                                 String?
  dateCreation                                DateTime?                                    @db.Date
  /// Code catégorie juridique INSEE brut (fiche annuaire, ex. « 5710 ») — additif, NULL = jamais fourni.
  natureJuridiqueCode                         String?
  /// Qualification RGE à l'annuaire au provisioning (Pack BTP) — NULL = jamais interrogée, aucun rétro-remplissage.
  estRge                                      Boolean?
  /// A6 — Capital social en CENTIMES (art. R123-238 code de commerce : forme + capital sur les
  /// documents des sociétés). Additif, NULL = jamais saisi — sociétés uniquement (garde domaine
  /// Company.of + CHECK > 0) ; aucun backfill inventé.
  capitalSocialCents                          BigInt?
  /// A2 — Médiateur de la consommation (art. L612-1 et L616-1 code de la consommation).
  /// Les deux colonnes vont ensemble (CHECK both-or-neither) ; NULL = jamais saisi.
  mediateurConsoNom                           String?
  mediateurConsoCoordonnees                   String?
  /// A3 — coordonnées DE L'ENTREPRISE requises par les modèles types de rétractation en vigueur
  /// (formulaire annexe R221-1 : adresse électronique ; avis annexe R221-3, instruction (2) :
  /// téléphone ET adresse électronique — décret n° 2022-424 du 25/03/2022). Additives, NULL =
  /// jamais saisies (réglages entreprise) — aucun backfill inventé.
  email                                       String?
  phone                                       String?
  iban                                        String?
  bic                                         String?
  insurerName                                 String?
  policyNo                                    String?
  coverage                                    String?
  policyExpiresAt                             DateTime?
  // Clôture de compte (Apple 5.1.1(v), CloseAccount @bob/core) — additif, JAMAIS un cascade
  // delete : présent = tenant clôturé (guard API : 403 « compte clôturé »). TOUS les autres
  // champs de ce modèle restent INTACTS après clôture — ce sont la source live relue à chaque
  // régénération d'une pièce déjà émise (factures/devis), la rétention légale de 10 ans (Code de
  // commerce) l'exige. L'identité PERSONNELLE de l'utilisateur (prénom, email, téléphone) ne vit
  // jamais ici : elle est entièrement dans Supabase Auth, supprimée via l'admin API en parallèle.
  closedAt                                    DateTime?
  closureReason                               String?
  customers                                   Customer[]
  customerContacts                            CustomerContact[]
  quotes                                      Quote[]
  invoices                                    Invoice[]
  invoicePredecessors                         InvoicePredecessor[]
  payments                                    Payment[]
  publicAccessTokens                          PublicAccessToken[]
  expenses                                    Expense[]
  expenseCreationRequests                     ExpenseCreationRequest[]
  quoteCreationRequests                       QuoteCreationRequest[]
  quoteDraftSlots                             QuoteDraftSlot[]
  agentMissions                               AgentMission[]
  agentMissionEvents                          AgentMissionEvent[]
  documents                                   StoredDocument[]
  documentFolders                             DocumentFolder[]
  folderDeletionPlans                         DocumentFolderDeletionPlan[]
  documentArchiveJobs                         DocumentArchiveJob[]
  notificationJobs                            NotificationJob[]
  devices                                     Device[]
  agentJournalEntries                         AgentJournalEntry[]
  accountingAccounts                          AccountingAccount[]
  accountingEntries                           AccountingEntry[]
  supplierMemory                              SupplierMemoryProfile[]
  cataloguePrestations                        CataloguePrestation[]
  chantiers                                   Chantier[]
  chantierNotes                               ChantierNote[]
  chantierPhotos                              ChantierPhoto[]
  bankBalanceSnapshots                        BankBalanceSnapshot[]
  counters                                    DocumentCounter[]
  realtimeAdmissionEvents                     RealtimeAdmissionEvent[]
  realtimeSessionLeases                       RealtimeSessionLease[]
  realtimeMistralTickets                      RealtimeMistralIngressTicket[]
  realtimeMistralConversationBootstrapTickets RealtimeMistralConversationBootstrapTicket[]
  realtimeMistralMissions                     RealtimeMistralConversationMission[]
  realtimeMistralTerminalReceipts             RealtimeMistralConversationTerminalReceipt[]
  realtimeMistralResumeTickets                RealtimeMistralConversationResumeTicket[]
  realtimeSpeechArtifacts                     RealtimeSpeechArtifact[]
  realtimeNativeSpeechDeliveries              RealtimeNativeSpeechDelivery[]
  realtimeControlGrants                       RealtimeControlGrant[]
  realtimeControlUses                         RealtimeControlConsumption[]
  realtimeVoiceUsage                          RealtimeVoiceUsageEvent[]
  realtimeVoiceUsageDaily                     RealtimeVoiceUsageDaily[]
  voiceTraces                                 VoiceTrace[]
  subscription                                Subscription?
  fiscalProfile                               FiscalProfile?
  billingSettings                             CompanyBillingSettings?
  diagnosticAssessment                        CompanyDiagnosticAssessment?

  @@map("companies")
}

/// Politique produit de présentation et valeurs initiales des pièces. Une ligne canonique par
/// société ; le mobile ne possède aucun fallback local. `revision` protège les mises à jour
/// concurrentes entre appareils par compare-and-swap.
model CompanyBillingSettings {
  companyId                      String                @id
  company                        Company               @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  showRibOnInvoices              Boolean               @default(false)
  showInsuranceOnInvoices        Boolean               @default(true)
  pdfAccentColor                 InvoicePdfAccentColor @default(navy)
  defaultQuoteValidityDays       Int                   @default(30)
  defaultDepositPercent          Int                   @default(30)
  /// Null jusqu'au choix explicite du propriétaire : l'émission ne suppose jamais 30 jours.
  defaultInvoicePaymentTermsDays Int?
  /// PR-06 — cadence de relance PERSONNALISÉE : les QUATRE seuils vont ensemble (CHECK SQL
  /// company_billing_settings_relance_policy_shape : tous NULL = DEFAULT_RELANCE_POLICY, ou
  /// tous non NULL strictement croissants, 1..365). La MED reste jamais envoyée seule.
  relanceCordialAfterDays        Int?
  relanceNeutreAfterDays         Int?
  relanceFermeAfterDays          Int?
  relanceMiseEnDemeureAfterDays  Int?
  /// PR-06 — relances AUTOMATIQUES (cron) actives ; le manuel reste toujours possible.
  relanceAutoEnabled             Boolean               @default(true)
  revision                       Int                   @default(1)
  createdAt                      DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt                      DateTime              @updatedAt @db.Timestamptz(6)

  @@map("company_billing_settings")
}

/// Dernier diagnostic explicitement terminé par le propriétaire. L'absence de ligne signifie
/// « jamais réalisé » — aucun seed ni défaut n'est créé au provisioning. Score et axes sont des
/// résultats serveur figés avec l'empreinte des sources BDD ; `revision` porte le CAS multi-device.
/// La clôture de compte est additive (`Company.closedAt`) : la ligne reste conservée mais devient
/// inaccessible avec le tenant, comme les autres preuves métier soumises à rétention.
model CompanyDiagnosticAssessment {
  companyId         String   @id
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  answers           Json
  score             Int
  receptionScore    Int
  emissionScore     Int
  dataQualityScore  Int
  sourceFingerprint String   @db.Char(64)
  rulesetVersion    Int
  sourceAsOf        DateTime @db.Date
  revision          Int      @default(1)
  createdAt         DateTime @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @db.Timestamptz(6)

  @@map("company_diagnostic_assessments")
}

/// Preuve append-only d'un solde réellement observé. Aucune ligne n'est créée par défaut :
/// saisie propriétaire confirmée, relevé importé ou connecteur bancaire uniquement.
model BankBalanceSnapshot {
  id                   String                          @id
  companyId            String
  company              Company                         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  amountCents          BigInt
  currency             String                          @default("EUR")
  source               BankBalanceSource
  reconciliationStatus BankBalanceReconciliationStatus
  observedAt           DateTime                        @db.Timestamptz(6)
  recordedAt           DateTime                        @default(now()) @db.Timestamptz(6)

  @@index([companyId, observedAt(sort: Desc), recordedAt(sort: Desc), id(sort: Desc)], map: "bank_balance_snapshots_company_latest_idx")
  @@map("bank_balance_snapshots")
}

/// Slot de brouillon de devis serveur : un seul brouillon actif par propriétaire et par société.
/// Le payload JSON est versionné et revalidé par le core à chaque lecture/écriture ; `revision`
/// porte le compare-and-swap afin qu'un appareil périmé ne puisse jamais écraser un autre appareil.
model QuoteDraftSlot {
  companyId      String
  company        Company       @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  ownerUserId    String
  revision       Int           @default(1)
  payloadVersion Int           @default(1)
  payload        Json
  /// Marqueur additif de possession. NULL conserve exactement le contrat writer N-1.
  agentMissionId String?       @db.Uuid
  agentMission   AgentMission? @relation("AgentMissionQuoteDraft", fields: [agentMissionId, companyId, ownerUserId], references: [id, companyId, ownerUserId], onDelete: Restrict, onUpdate: Cascade)
  createdAt      DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(6)

  @@id([companyId, ownerUserId], name: "quote_draft_slot_owner")
  @@unique([agentMissionId, companyId, ownerUserId], map: "quote_draft_slots_agent_mission_owner_key")
  @@map("quote_draft_slots")
}

/// Mission métier provider-neutral : uniquement identifiants, révisions, décisions structurées et
/// digests. Aucun transcript, nom client, montant ou texte LLM n'est persistant ici.
model AgentMission {
  id                 String              @id @db.Uuid
  companyId          String
  company            Company             @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  ownerUserId        String
  kind               String
  status             String
  phase              String
  revision           Int
  payloadVersion     Int
  payload            Json
  currentBinding     Json?
  idleExpiresAt      DateTime            @db.Timestamptz(6)
  hardExpiresAt      DateTime            @db.Timestamptz(6)
  terminalAt         DateTime?           @db.Timestamptz(6)
  retentionExpiresAt DateTime            @db.Timestamptz(6)
  createdAt          DateTime            @db.Timestamptz(6)
  updatedAt          DateTime            @db.Timestamptz(6)
  events             AgentMissionEvent[] @relation("AgentMissionEvents")
  quoteDraftSlots    QuoteDraftSlot[]    @relation("AgentMissionQuoteDraft")

  @@unique([id, companyId, ownerUserId], map: "agent_missions_owner_binding_key")
  @@index([companyId, ownerUserId, kind, status], map: "agent_missions_owner_status_idx")
  @@index([retentionExpiresAt], map: "agent_missions_retention_idx")
  @@map("agent_missions")
}

/// Journal append-only d'une mission. Le payload `data` est une union fermée sans texte libre.
model AgentMissionEvent {
  id                                 String       @id @db.Uuid
  companyId                          String
  company                            Company      @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  ownerUserId                        String
  missionId                          String       @db.Uuid
  mission                            AgentMission @relation("AgentMissionEvents", fields: [missionId, companyId, ownerUserId], references: [id, companyId, ownerUserId], onDelete: Restrict, onUpdate: Cascade)
  sequence                           Int
  eventType                          String
  eventVersion                       Int
  actor                              String
  commandId                          String       @db.Uuid
  requestFingerprintHmac             String       @db.Char(64)
  fingerprintKeyVersion              Int
  fingerprintCanonicalizationVersion Int
  missionRevisionBefore              Int
  missionRevisionAfter               Int
  draftSlotRevisionBefore            Int?
  draftSlotRevisionAfter             Int?
  draftContentRevisionBefore         Int?
  draftContentRevisionAfter          Int?
  realtimeSessionId                  String?      @db.Uuid
  turnId                             String?      @db.Uuid
  contextRevision                    Int?
  contextDigest                      String?      @db.Char(64)
  data                               Json
  occurredAt                         DateTime     @db.Timestamptz(6)
  retentionExpiresAt                 DateTime     @db.Timestamptz(6)

  @@unique([companyId, ownerUserId, commandId], map: "agent_mission_events_owner_command_key")
  @@unique([missionId, sequence], map: "agent_mission_events_sequence_key")
  @@index([companyId, ownerUserId, missionId, occurredAt], map: "agent_mission_events_owner_timeline_idx")
  @@index([retentionExpiresAt], map: "agent_mission_events_retention_idx")
  @@map("agent_mission_events")
}

model Customer {
  id                       String       @id
  companyId                String
  company                  Company      @relation(fields: [companyId], references: [id])
  type                     CustomerType
  name                     String
  siren                    String?      @db.Char(9)
  /// N° TVA français réellement saisi/confirmé. Jamais calculé depuis le SIREN.
  tvaIntracom              String?
  isInternational          Boolean      @default(false)
  addrLine1                String
  addrZip                  String
  addrCity                 String
  email                    String?
  phone                    String?
  /// Nom du contact chez le client entreprise/public (raison sociale ≠ personne physique jointe).
  contactName              String?
  ptLabel                  String?
  /// B4 — conditions de paiement PROPRES au client (jours + fin de mois + libellé imprimable),
  /// pilotant l'échéance dérivée à l'émission (IssueInvoice, priorité 2 après le choix explicite).
  /// Les TROIS colonnes vont ensemble (CHECK SQL) ; NULL = défaut société. `ptLabel` historique
  /// reste purement décoratif.
  paymentTermsDays         Int?
  paymentTermsEndOfMonth   Boolean?
  paymentTermsLabel        String?
  /// Canal de FACTURATION du client (email | chorus | portail) — NULL = email (défaut honnête).
  /// Champs annexes liés à LEUR type par CHECK SQL (un code service hors Chorus est un état
  /// sans sens). Le guide de transmission de la facture émise en dérive (deriveTransmissionGuide).
  billingChannelType       String?
  billingChorusServiceCode String?
  billingPortailNom        String?
  billingPortailUrl        String?
  /// PR-04 — garde « BC obligatoire » PAR CLIENT (amendement fondateur : désactivée par
  /// défaut). NULL = non exigé (comportement historique inchangé) ; true = l'émission d'une
  /// facture sans n° de bon de commande est refusée (override confirmé JOURNALISÉ possible).
  /// Cas RATP CAP : plus jamais une facture sans n° d'engagement.
  requiresPurchaseOrder    Boolean?
  isSubcontractingBtp      Boolean      @default(false)
  chantiers                Chantier[]
  quotes                   Quote[]
  invoices                 Invoice[]
  contacts                 CustomerContact[]

  @@unique([id, companyId], name: "uniq_customer_id_company", map: "uniq_customer_id_company")
  @@index([companyId])
  @@index([companyId, type])
  // B9 — recherche floue « retrouve les devis de Mairie de Sèvres » (GET /documents/search,
  // /documents/suggest) : index GIN trigram customers_name_trgm_idx sur
  // immutable_unaccent(lower(name)) — le nom client n'est jamais dénormalisé sur quotes/invoices,
  // un seul index ici sert le join + l'autocomplétion. VOLONTAIREMENT ABSENT du DSL Prisma :
  // c'est un index D'EXPRESSION (accents/casse pliés), que `@@index` ne sait pas représenter —
  // il vit uniquement dans la migration b9_documents_search_indexes. NE JAMAIS le "nettoyer"
  // en pensant combler un drift : `prisma migrate diff` l'ignore silencieusement (type non
  // modélisable), il n'est ni recréé ni supprimé par erreur.
  @@map("customers")
}

/// PR-09 — contacts multiples d'un client (exigence 1) : plusieurs personnes jointes par fiche
/// (demandeur, valideur, compta…), rôle porté par un `label` LIBRE — aucune taxonomie codée.
/// FK composite (customerId, companyId) anti-IDOR : jamais un contact pointant le client d'un
/// autre tenant, même en cas de défaut applicatif. Les coordonnées historiques de la fiche
/// (Customer.contactName/email) restent le défaut d'envoi ; les contacts s'y AJOUTENT.
model CustomerContact {
  id         String   @id
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  customerId String
  customer   Customer @relation(fields: [customerId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Cascade)
  label      String
  name       String
  email      String?
  phone      String?
  revision   Int      @default(1)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)

  @@unique([id, companyId], name: "uniq_customer_contact_id_company", map: "uniq_customer_contact_id_company")
  @@index([companyId, customerId], map: "customer_contacts_company_customer_idx")
  @@map("customer_contacts")
}

/// Catalogue tarifaire personnel du tenant. Aucun enregistrement n'est seedé en production :
/// chaque ligne vient d'une création explicite du propriétaire ou d'un import qu'il confirme.
model CataloguePrestation {
  id          String       @id
  companyId   String
  company     Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  label       String
  category    LineCategory
  unit        String?
  unitPriceHt Int
  vatRate     Decimal      @db.Decimal(4, 2)
  revision    Int          @default(1)
  createdAt   DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(6)

  @@unique([id, companyId], name: "uniq_catalogue_prestation_id_company", map: "uniq_catalogue_prestation_id_company")
  @@index([companyId, category, label], map: "catalogue_prestations_company_category_label_idx")
  @@map("catalogue_prestations")
}

/// Dossier chantier durable. Le lien client est composite afin qu'une ligne ne puisse jamais
/// référencer un client d'un autre tenant, y compris en cas de défaut applicatif.
model Chantier {
  id            String          @id
  companyId     String
  company       Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  name          String
  customerId    String?
  customer      Customer?       @relation(fields: [customerId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Cascade)
  address       String?
  notes         String?
  status        ChantierStatus  @default(open)
  openedAt      DateTime        @db.Date
  createdAt     DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime        @updatedAt @db.Timestamptz(6)
  chantierNotes ChantierNote[]
  photos        ChantierPhoto[]
  expenses      Expense[]
  // PR-08 — pièces du site (chantierId nullable sur quotes/invoices, patron Expense).
  quotes        Quote[]         @relation("ChantierQuotes")
  invoices      Invoice[]       @relation("ChantierInvoices")

  @@unique([id, companyId], name: "uniq_chantier_id_company", map: "uniq_chantier_id_company")
  @@index([companyId, status, openedAt(sort: Desc)], map: "chantiers_company_status_opened_idx")
  @@index([customerId, companyId], map: "chantiers_customer_company_idx")
  @@map("chantiers")
}

/// Journal d'activité horodaté d'un chantier/projet — DISTINCT de Chantier.notes (description de
/// création). Append-only (V1) : jamais éditée ni supprimée.
model ChantierNote {
  id          String   @id
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  chantierId  String
  chantier    Chantier @relation(fields: [chantierId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Cascade)
  text        String
  authorLabel String
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  @@index([companyId, chantierId, createdAt(sort: Desc)], map: "chantier_notes_chantier_created_idx")
  @@map("chantier_notes")
}

/// Photo liée à un chantier/projet — métadonnées SÉPARÉES du coffre documents fiscal
/// (StoredDocument porte rétention/versions/classification propres aux pièces légales, hors
/// sujet ici). Octets stockés via le même DocumentStoragePort (storageKey).
model ChantierPhoto {
  id         String   @id
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  chantierId String
  chantier   Chantier @relation(fields: [chantierId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Cascade)
  filename   String
  mimeType   String
  byteSize   Int
  storageKey String   @unique
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  @@index([companyId, chantierId, createdAt(sort: Desc)], map: "chantier_photos_chantier_created_idx")
  @@map("chantier_photos")
}

model Quote {
  id                        String                 @id
  companyId                 String
  company                   Company                @relation(fields: [companyId], references: [id])
  customerId                String
  customer                  Customer               @relation(fields: [customerId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  status                    QuoteStatus            @default(draft)
  number                    String?
  // B9 — un devis n'a pas de date métier propre (contrairement à Invoice.issuedAt) : createdAt
  // tient lieu de date de référence pour la recherche/le tri par période ("le mois dernier").
  // Lecture seule côté domaine (non threadé dans l'agrégat Quote, hors invariants métier).
  createdAt                 DateTime               @default(now())
  validUntil                DateTime?
  /// A1 — date d'établissement du devis (arrêté du 24/01/2017), dérivée à l'envoi au jour métier
  /// Paris par l'agrégat Quote. NULL = brouillon, ou devis legacy envoyé avant l'ajout du champ
  /// (jamais rétro-daté depuis createdAt).
  issuedAt                  DateTime?              @db.Date
  depositPct                Int?
  signerName                String?
  signedAt                  DateTime?
  // R4 : preuve de signature honnête — JSON { method: 'onsite_draw'|'remote_link', sha256?, capturedAt? }.
  // NULL = ligne historique (méthode réelle inconnue, réhydratée 'legacy_declared', jamais réinventée).
  // V1 : hash + méta uniquement ; l'archivage de l'image du tracé est l'évolution suivante.
  signatureProof            Json?
  /// A3 — demande EXPRESSE d'exécution anticipée des travaux (art. L221-25 code conso), cochée
  /// par le client CONSOMMATEUR au moment de signer et horodatée SERVEUR : elle lève le gel de
  /// rétractation de la facture finale. NULL = jamais demandée (B2B, case non cochée, ou ligne
  /// historique antérieure au champ — jamais rétro-remplie).
  earlyExecutionRequestedAt DateTime?              @db.Timestamptz(6)
  /// A3 — qualité du client FIGÉE à la CONCLUSION du contrat (SignQuote, même transaction que
  /// la signature) : décide du droit de rétractation et de l'embargo L221-10 même si la fiche
  /// client change ensuite. NULL = signature antérieure au figeage (fallback : type courant).
  signatureCustomerType     CustomerType?
  /// A3 — rétractation du consommateur exercée via la fonctionnalité en ligne (art. L221-21
  /// dernier al. c. conso). NULL = jamais exercée ; horodatée SERVEUR, jamais réécrite.
  retractedAt               DateTime?              @db.Timestamptz(6)
  /// Exception dépannage urgent (art. L221-10, al. 2 et L221-28, 8° c. conso) : intervention
  /// urgente EXPRESSÉMENT sollicitée par le client B2C, posée À LA CRÉATION du devis (wizard),
  /// horodatée SERVEUR, immuable. NULL = jamais sollicitée (fail-closed : embargo L221-10 plein).
  urgentRepairRequestedAt   DateTime?              @db.Timestamptz(6)
  totalsHt                  Int                    @default(0)
  totalsVat                 Int                    @default(0)
  totalsTtc                 Int                    @default(0)
  totalsNetToPay            Int                    @default(0)
  vatByRate                 Json                   @default("{}")
  // B8 — bon de commande client (numéro d'engagement grands comptes/Chorus Pro), saisi UNE FOIS
  // sur le devis puis repris sur la facture dérivée. Anti-IDOR : le document du coffre lié est
  // contraint au MÊME tenant par la FK composite (companyId, purchaseOrderDocumentId).
  purchaseOrderNumber       String?
  purchaseOrderReceivedAt   DateTime?              @db.Timestamptz(6)
  purchaseOrderDocumentId   String?
  purchaseOrderDocument     StoredDocument?        @relation("QuotePurchaseOrderDocument", fields: [companyId, purchaseOrderDocumentId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade)
  // B3 — remise GLOBALE du devis (négociée UNE FOIS, reprise sur les pièces dérivées) :
  // pourcentage OU montant HT centimes, exclusifs (CHECK SQL). NULL/NULL = aucune remise.
  globalDiscountPercent     Decimal?               @db.Decimal(5, 2)
  globalDiscountAmountCents Int?
  // B5 — retenue de garantie stipulée au devis (loi n° 71-584, ≤ 5 %) : s'applique aux
  // situations et à la finale dérivées. NULL = aucune retenue.
  retenueGarantiePct        Decimal?               @db.Decimal(5, 2)
  // PR-08 — site/chantier de rattachement de la pièce (patron Expense.chantierId) : NULL =
  // devis hors site, aucun backfill (les pièces historiques restent honnêtement hors site).
  // FK composite (chantierId, companyId) anti-IDOR — jamais un chantier d'un autre tenant.
  chantierId                String?
  chantier                  Chantier?              @relation("ChantierQuotes", fields: [chantierId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Cascade)
  // Révision optimiste (B8) : incrémentée par les mutations de bon de commande — le CAS final
  // en base est porté par le verrou de ligne (lockById) dans la transaction tenant.
  revision                  Int                    @default(1)
  lines                     LineItem[]             @relation("QuoteLines")
  creationRequests          QuoteCreationRequest[]
  generatedInvoices         Invoice[]              @relation("QuoteGeneratedInvoices")

  @@unique([companyId, number], name: "uniq_quote_number")
  @@unique([id, companyId], name: "uniq_quote_id_company", map: "uniq_quote_id_company")
  @@index([companyId, status])
  @@index([customerId, companyId], map: "quotes_customer_company_idx")
  // B8 — descente FK du document de bon de commande (partiel WHERE NOT NULL en SQL, comme
  // invoices_deposit_company_idx).
  @@index([purchaseOrderDocumentId, companyId], map: "quotes_po_document_company_idx")
  // B9 — chips de dates ("ce mois-ci"/"mois dernier") : tenant + tri/plage sur une seule
  // descente d'index, sans tri en mémoire côté Postgres.
  @@index([companyId, createdAt(sort: Desc)], map: "quotes_company_created_idx")
  // B9 — recherche "contient" sur le numéro (ex. taper "014" doit retrouver "DEV-2026-014") : le
  // B-Tree unique (companyId, number) ne sert que l'égalité/préfixe. index GIN trigram
  // quotes_number_trgm_idx (migration b9_documents_search_indexes) — même remarque "absent du
  // DSL" que customers_name_trgm_idx ci-dessus (index d'expression).
  // PR-08 — lecture « pièces d'un site » servie par index (patron expenses_company_chantier_idx).
  @@index([companyId, chantierId], map: "quotes_company_chantier_idx")
  @@map("quotes")
}

model Invoice {
  id                          String               @id
  companyId                   String
  company                     Company              @relation(fields: [companyId], references: [id])
  customerId                  String
  customer                    Customer             @relation(fields: [customerId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  kind                        DocKind
  status                      InvoiceStatus        @default(draft)
  number                      String?
  issuedAt                    DateTime?
  dueAt                       DateTime?
  /// A7 — date/période de la prestation si distincte de l'émission (art. 242 nonies A CGI,
  /// L441-9 c. com.) — FIGÉE à l'émission (trigger invoices_legal_traceability). NULL = non
  /// renseignée ; servicePeriodEnd NULL = prestation ponctuelle d'un seul jour.
  servicePeriodStart          DateTime?            @db.Date
  servicePeriodEnd            DateTime?            @db.Date
  /// A7 — adresse de chantier/livraison si distincte de la facturation — FIGÉE à l'émission.
  deliveryAddress             String?
  parentQuoteId               String?
  parentQuote                 Quote?               @relation("QuoteGeneratedInvoices", fields: [parentQuoteId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  // Trace légale immuable de la facture exacte annulée par un avoir total.
  // Les quatre champs sont tous NULL hors avoir et tous renseignés pour tout nouvel avoir.
  sourceInvoiceId             String?
  sourceInvoiceKind           DocKind?
  sourceInvoiceNumber         String?
  sourceInvoiceIssuedAt       DateTime?
  sourceInvoice               Invoice?             @relation("InvoiceCreditNotes", fields: [sourceInvoiceId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  creditNotes                 Invoice[]            @relation("InvoiceCreditNotes")
  depositPct                  Int?
  // Acompte déjà facturé, déduit du net à payer d'une finale (A2-C16).
  depositDeductionCents       Int                  @default(0)
  depositInvoiceId            String?
  depositInvoice              Invoice?             @relation("InvoiceDepositDeductions", fields: [depositInvoiceId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  deductedByInvoices          Invoice[]            @relation("InvoiceDepositDeductions")
  paidCents                   Int                  @default(0)
  /// Version du contrat de règlement. `1` relit strictement les pièces historiques ; `2`
  /// sépare créance légale, exigible immédiat et retenue sans réinterprétation au rechargement.
  settlementSemanticsVersion  Int                  @default(1)
  totalsHt                    Int                  @default(0)
  totalsVat                   Int                  @default(0)
  totalsTtc                   Int                  @default(0)
  totalsNetToPay              Int                  @default(0)
  /// Créance légale totale figée (BT-115). NULL = pièce historique V1 sans fait persisté.
  totalsDuePayableCents       Int?
  vatByRate                   Json                 @default("{}")
  /// B3/B5 — compléments de totaux PRÉSENTS UNIQUEMENT quand le fait existe (Totals.grossHt?/
  /// discountCents?/retenueGarantieCents?) : les pièces antérieures restent identiques au centime.
  totalsGrossHt               Int?
  totalsDiscountCents         Int?
  totalsRetenueGarantieCents  Int?
  /// B2 — situation de travaux : n° d'ordre sur SON devis (1, 2, 3…) ; part de la déduction de
  /// la finale provenant des situations émises (compta : CA jamais compté deux fois).
  situationOrder              Int?
  situationDeductionCents     Int                  @default(0)
  /// B3 — remise globale de la pièce (reprise du devis à la dérivation, ou saisie sur facture
  /// directe) : % OU montant HT centimes, exclusifs (CHECK SQL).
  globalDiscountPercent       Decimal?             @db.Decimal(5, 2)
  globalDiscountAmountCents   Int?
  /// B5 — taux de retenue de garantie applicable à la pièce (situations + finale). NULL = aucune.
  retenueGarantiePct          Decimal?             @db.Decimal(5, 2)
  /// B1/A3bis — facture DIRECTE B2C : intervention urgente à domicile expressément sollicitée
  /// (art. L221-10, al. 2 et L221-28, 8° c. conso), horodatée SERVEUR à la composition,
  /// IMMUABLE. NULL = jamais sollicitée (fail-closed).
  urgentRepairRequestedAt     DateTime?            @db.Timestamptz(6)
  /// Suivi MANUEL de transmission (canal de facturation du client) : dates DÉCLARÉES par
  /// l'artisan (dépôt Chorus/portail puis acceptation) — mutables APRÈS émission (suivi
  /// opérationnel, pas un fait légal de la pièce). NULL = jamais suivi.
  transmissionDepositedAt     DateTime?            @db.Date
  transmissionAcceptedAt      DateTime?            @db.Date
  legalMentions               String[]             @default([])
  /// A4 — régime de TVA de la pièce, CONSTATÉ par IssueInvoice et FIGÉ à l'émission (franchise
  /// 293 B / autoliquidation 283, 2 nonies / standard) — le XML Factur-X régénéré le lit en
  /// priorité, plus jamais l'état mutable de la fiche client. NULL = pièce émise avant le
  /// figeage (dérivation dynamique honnête, jamais rétro-déduite).
  vatTreatmentAtIssuance      String?
  /// BT-23 — cadre de facturation France exact, résolu avant numérotation et figé avec la pièce.
  /// NULL uniquement pour les archives historiques antérieures au writer 2026.
  frenchBillingModeAtIssuance String?
  /// Périmètre d'archive figé à l'émission : consumer = PDF original seul ; professional =
  /// PDF + XML Factur-X. NULL signifie legacy non prouvé et bloque la clôture V2.
  archiveAudienceAtIssuance   String?
  // B8 — bon de commande repris du devis à la dérivation (ou attaché en brouillon), FIGÉ à
  // l'émission (trigger invoices_legal_traceability). FK composite anti-IDOR comme sur quotes.
  purchaseOrderNumber         String?
  purchaseOrderReceivedAt     DateTime?            @db.Timestamptz(6)
  purchaseOrderDocumentId     String?
  purchaseOrderDocument       StoredDocument?      @relation("InvoicePurchaseOrderDocument", fields: [companyId, purchaseOrderDocumentId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade)
  // PR-08 — site/chantier de rattachement (patron Expense.chantierId) : posé à la composition
  // directe ou REPRIS du devis parent à la dérivation. NULL = pièce hors site, aucun backfill.
  // FIGÉ post-émission depuis 20260727120000_invoices_chantier_freeze (trigger redéfini depuis
  // sa dernière version 20260720010000, annexe errata n° 1) — PR-12b n'ajoutera que
  // maintenanceContractId à la liste.
  chantierId                  String?
  chantier                    Chantier?            @relation("ChantierInvoices", fields: [chantierId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Cascade)
  // Révision optimiste (B8) — mutations de bon de commande uniquement à ce jour.
  revision                    Int                  @default(1)
  lines                       LineItem[]           @relation("InvoiceLines")
  payments                    Payment[]
  precedingInvoices           InvoicePredecessor[] @relation("InvoicePredecessorTarget")
  successorInvoices           InvoicePredecessor[] @relation("InvoicePredecessorSource")

  @@unique([companyId, number], name: "uniq_invoice_number")
  @@unique([id, companyId], name: "uniq_invoice_id_company", map: "uniq_invoice_id_company")
  @@unique([companyId, sourceInvoiceId], name: "uniq_credit_note_source_invoice", map: "uniq_credit_note_source_invoice")
  @@index([companyId, parentQuoteId, kind], map: "invoices_parent_quote_kind_idx")
  @@index([companyId, status])
  @@index([customerId, companyId], map: "invoices_customer_company_idx")
  @@index([depositInvoiceId, companyId], map: "invoices_deposit_company_idx")
  // B8 — descente FK du document de bon de commande (partiel WHERE NOT NULL en SQL).
  @@index([purchaseOrderDocumentId, companyId], map: "invoices_po_document_company_idx")
  @@index([dueAt])
  // B9 — chips de dates ("ce mois-ci"/"mois dernier") : tenant + tri/plage sur une seule
  // descente d'index. issuedAt est NULL en brouillon — hors périmètre "recherche par période"
  // par construction (une pièce non émise n'a pas encore de date métier).
  @@index([companyId, issuedAt(sort: Desc)], map: "invoices_company_issued_idx")
  // B9 — recherche "contient" sur le numéro, même besoin que quotes_number_trgm_idx : index GIN
  // trigram invoices_number_trgm_idx (migration b9_documents_search_indexes, absent du DSL).
  // PR-08 — lecture « pièces d'un site » servie par index (patron expenses_company_chantier_idx).
  @@index([companyId, chantierId], map: "invoices_company_chantier_idx")
  @@map("invoices")
}

/// Références aux pièces antérieures d'une facture finale. Les deux FK composites garantissent
/// que cible et source appartiennent au même tenant ; les snapshots sont validés et figés en SQL.
model InvoicePredecessor {
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  invoiceId       String
  invoice         Invoice  @relation("InvoicePredecessorTarget", fields: [invoiceId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  sourceInvoiceId String
  sourceInvoice   Invoice  @relation("InvoicePredecessorSource", fields: [sourceInvoiceId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  kind            DocKind
  number          String
  issuedAt        DateTime @db.Date
  position        Int

  @@id([companyId, invoiceId, position], name: "invoice_predecessors_pkey")
  @@unique([companyId, invoiceId, sourceInvoiceId], name: "uniq_invoice_predecessor_source")
  @@index([sourceInvoiceId, companyId], map: "invoice_predecessors_source_company_idx")
  @@map("invoice_predecessors")
}

/// Rail monotone de déploiement V1→V2. La migration installe V1 (writers N-1 encore tolérés) ;
/// l'activation V2 n'intervient qu'après preuve que la nouvelle révision est seule en service.
model InvoiceSettlementProtocolState {
  id                    Int       @id @db.SmallInt
  activeVersion         Int       @db.SmallInt
  activatedAt           DateTime? @db.Timestamptz(6)
  activatedByReleaseSha String?   @db.Char(40)
  createdAt             DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(6)

  @@map("invoice_settlement_protocol_state")
}

/// Rail monotone du passage de l'ancien worker d'archive (mutations SQL directes) aux capacités
/// bornées V2. L'état est global et administré uniquement avec DIRECT_URL après readiness.
model DocumentArchiveProtocolState {
  id                    Int                            @id @db.SmallInt
  activeVersion         Int                            @db.SmallInt
  databaseIdentity      String                         @unique @default(uuid()) @db.Uuid
  activatedAt           DateTime?                      @db.Timestamptz(6)
  activatedByReleaseSha String?                        @db.Char(40)
  createdAt             DateTime                       @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime                       @updatedAt @db.Timestamptz(6)
  auditEvidence         DocumentArchiveAuditEvidence[] @relation("DocumentArchiveAuditDatabaseIdentity")

  @@map("document_archive_protocol_state")
}

/// Preuve opérationnelle append-only du scanner historique. L'enveloppe exportée reste sans PII ;
/// le rapport détaillé optionnel demeure privé à DIRECT_URL pour diagnostiquer un refus.
model DocumentArchiveAuditEvidence {
  id                      String                       @id @default(uuid()) @db.Uuid
  deploymentId            String                       @unique(map: "document_archive_audit_evidence_deployment_key") @db.Uuid
  releaseSha              String                       @db.Char(40)
  databaseIdentity        String                       @db.Uuid
  storageBucket           String
  protocolState           DocumentArchiveProtocolState @relation("DocumentArchiveAuditDatabaseIdentity", fields: [databaseIdentity], references: [databaseIdentity], onDelete: Restrict, onUpdate: Restrict)
  protocolVersion         Int                          @db.SmallInt
  mode                    String
  inventoryDigest         String                       @db.Char(64)
  reportSha256            String                       @db.Char(64)
  validatorEvidenceDigest String                       @db.Char(64)
  validatorVersions       Json
  counts                  Json
  issueCodes              String[]
  privateReport           Json?
  readyForActivation      Boolean
  auditedAt               DateTime                     @db.Timestamptz(6)
  createdAt               DateTime                     @default(now()) @db.Timestamptz(6)

  @@unique([releaseSha, inventoryDigest, reportSha256], map: "document_archive_audit_evidence_exact_replay_key")
  @@index([releaseSha, readyForActivation, auditedAt], map: "document_archive_audit_evidence_release_ready_idx")
  @@map("document_archive_audit_evidence")
}

model LineItem {
  id                  String       @id @default(uuid())
  quoteId             String?
  quote               Quote?       @relation("QuoteLines", fields: [quoteId], references: [id])
  invoiceId           String?
  invoice             Invoice?     @relation("InvoiceLines", fields: [invoiceId], references: [id], onDelete: Restrict)
  position            Int
  label               String
  category            LineCategory
  qty                 Decimal      @db.Decimal(12, 3)
  unit                String?
  unitPriceHt         Int
  vatRate             Decimal      @db.Decimal(4, 2)
  /// B3 — remise DE LIGNE, EXCLUSIVE : pourcentage (0 < % ≤ 100, 2 déc.) OU montant HT en
  /// centimes (> 0, plafonné par la base de la ligne côté domaine). CHECK SQL d'exclusivité.
  /// NULL/NULL = aucune remise (lignes antérieures inchangées au centime).
  discountPercent     Decimal?     @db.Decimal(5, 2)
  discountAmountCents Int?
  /// Ligne du devis signé à l'origine de cette ligne de facture. NULL pour les devis et les
  /// factures autonomes ; la FK + le trigger SQL refusent les références inter-tenant/hors devis.
  sourceQuoteLineId   String?
  sourceQuoteLine     LineItem?    @relation("InvoiceLineSourceQuoteLine", fields: [sourceQuoteLineId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  derivedInvoiceLines LineItem[]   @relation("InvoiceLineSourceQuoteLine")

  @@index([quoteId])
  @@index([invoiceId])
  @@index([sourceQuoteLineId], map: "line_items_source_quote_line_idx")
  // B9 — retrouver une pièce par le contenu d'une ligne ("peinture façade") sans scanner toute
  // line_items ("libellés de lignes" du cahier des charges) : index GIN trigram
  // line_items_label_trgm_idx (migration b9_documents_search_indexes, absent du DSL).
  @@map("line_items")
}

model Payment {
  id                       String        @id
  companyId                String
  company                  Company       @relation(fields: [companyId], references: [id])
  invoiceId                String
  invoice                  Invoice       @relation(fields: [invoiceId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  amount                   Int
  method                   PaymentMethod
  receivedAt               DateTime
  idempotencyKey           String?
  /// NULL uniquement pendant la fenêtre expand pour un writer N-1 ; le reader le traite comme
  /// `amount`/0, soit exactement l'écriture historique antérieure au compte 4117.
  ordinaryReceivableCents  Int?
  retentionReceivableCents Int?

  @@unique([companyId, idempotencyKey])
  @@index([invoiceId, companyId], map: "payments_invoice_company_idx")
  @@map("payments")
}

model PublicAccessToken {
  id           String                   @id
  companyId    String
  company      Company                  @relation(fields: [companyId], references: [id])
  tokenHash    String                   @unique
  resourceType PublicAccessResourceType
  resourceId   String
  scope        PublicAccessScope
  expiresAt    DateTime
  revokedAt    DateTime?
  lastUsedAt   DateTime?
  createdAt    DateTime                 @default(now())

  @@index([companyId, resourceType, resourceId, scope])
  @@map("public_access_tokens")
}

model Expense {
  id                              String                   @id
  companyId                       String
  company                         Company                  @relation(fields: [companyId], references: [id])
  supplierName                    String
  supplierSiren                   String?                  @db.Char(9)
  documentDate                    String
  totalTtcCents                   Int
  totalHtCents                    Int?
  vatCents                        Int?
  vatRatePct                      Float?
  category                        String
  status                          String                   @default("to_pay")
  /// Preuve explicite du règlement déclaré par le propriétaire. Jamais préremplie ni déduite.
  paymentPaidOn                   DateTime?                @db.Date
  paymentMethod                   PaymentMethod?
  paymentReference                String?                  @db.VarChar(140)
  paymentProofDocumentId          String?                  @db.VarChar(200)
  paymentProofDocument            StoredDocument?          @relation("ExpensePaymentProof", fields: [companyId, paymentProofDocumentId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade)
  /// TRUE uniquement pour une ligne historique déjà `paid` avant l'introduction de la preuve structurée.
  paymentEvidenceLegacyUnverified Boolean                  @default(false)
  source                          String                   @default("manual")
  /// C-EXP6b — n° de facture fournisseur (Factur-X BT-1) : clé anti-doublon avec le SIREN.
  supplierInvoiceNumber           String?
  /// C-EXP6b — échéance fournisseur (Factur-X BT-9), même format DateOnly que documentDate.
  dueAt                           String?
  /// Imputation chantier (rentabilité par chantier) — nullable : NULL = dépense hors chantier.
  /// Aucun backfill : les lignes historiques restent honnêtement hors chantier.
  chantierId                      String?
  chantier                        Chantier?                @relation(fields: [chantierId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Cascade)
  createdAt                       DateTime                 @default(now())
  creationRequests                ExpenseCreationRequest[]

  @@unique([id, companyId], name: "uniq_expense_id_company", map: "uniq_expense_id_company")
  @@index([companyId])
  @@index([companyId, paymentProofDocumentId])
  @@index([companyId, chantierId], map: "expenses_company_chantier_idx")
  // C-EXP-FIX1 (Bug 1 — DOUBLON TOCTOU) : index UNIQUE PARTIEL
  // (companyId, supplierSiren, supplierInvoiceNumber) WHERE supplierInvoiceNumber IS NOT NULL —
  // /// @unique partiel géré en SQL (Prisma ne l'exprime pas nativement), cf. migration
  // 20260705120000_expense_facturx_reception. Garde concurrentielle anti double e-facture ;
  // les dépenses manuelles/OCR (n° NULL) restent NON contraintes.
  @@map("expenses")
}

/// Registre d'idempotence des créations de dépenses. Le secret appelant n'est jamais stocké :
/// keyHash est un SHA-256 tenant-salé, payloadHash l'empreinte de l'intention comptable canonique.
/// Le rôle runtime n'a que SELECT/INSERT ; les lignes publiées sont immuables.
model ExpenseCreationRequest {
  companyId   String   @db.Text
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  keyHash     String   @db.Char(64)
  payloadHash String   @db.Char(64)
  expenseId   String
  expense     Expense  @relation(fields: [expenseId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Cascade)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  @@id([companyId, keyHash], name: "expense_creation_request_key")
  @@index([expenseId, companyId])
  @@map("expense_creation_requests")
}

/// Registre d'idempotence des créations de devis. La clé brute n'est jamais stockée :
/// keyHash est tenant-salé, payloadHash fige l'intention et les totaux figent la réponse originale.
/// Le rôle runtime n'a que SELECT/INSERT ; les lignes publiées sont immuables.
model QuoteCreationRequest {
  companyId      String   @db.Text
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  keyHash        String   @db.Char(64)
  payloadHash    String   @db.Char(64)
  quoteId        String
  quote          Quote    @relation(fields: [quoteId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Cascade)
  totalsHt       Int
  totalsVat      Int
  totalsTtc      Int
  totalsNetToPay Int
  vatByRate      Json     @default("{}")
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  @@id([companyId, keyHash], name: "quote_creation_request_key")
  @@index([quoteId, companyId])
  @@map("quote_creation_requests")
}

model SupplierMemoryProfile {
  id          String   @id
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  key         String
  displayName String
  siren       String?  @db.Char(9)
  category    String
  vatRatePct  Float?
  seen        Int      @default(1)
  lastSeenAt  DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([companyId, key], name: "uniq_supplier_memory_company_key")
  @@index([companyId])
  @@map("supplier_memory_profiles")
}

model StoredDocument {
  id                     String                          @id
  companyId              String
  company                Company                         @relation(fields: [companyId], references: [id])
  kind                   StoredDocumentKind
  origin                 StoredDocumentOrigin
  status                 StoredDocumentStatus            @default(active)
  filename               String
  /**
   * Libellé d'affichage renommable (« Facture Leroy Merlin — 184,90 € »). NULL = lignes
   * historiques : le domaine retombe sur le filename, aucune valeur n'est rétro-remplie.
   */
  displayName            String?
  mimeType               String
  byteSize               Int
  sha256                 String                          @db.Char(64)
  storageKey             String                          @unique
  folderId               String?
  folder                 DocumentFolder?                 @relation("StoredDocumentFolder", fields: [companyId, folderId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade)
  revision               Int                             @default(1)
  linkedEntityType       StoredDocumentLinkedEntityType?
  linkedEntityId         String?
  documentDate           String?
  issuedAt               String?
  createdAt              DateTime
  createdBy              String?
  retentionUntil         String
  deletedAt              DateTime?
  /**
   * Confirmation humaine (« c'est bon, je valide ») d'un document scanné — humain ou Bob,
   * parité voix. NULL = jamais validé : un doc rangé (folderId non nul) SANS validation reste
   * « à valider ». La première validation fait foi (latch), jamais réécrite.
   */
  reviewedAt             DateTime?
  tags                   String[]                        @default([])
  versions               StoredDocumentVersion[]
  invoicePdfAttestations DocumentInvoicePdfAttestation[] @relation("InvoicePdfAttestationDocument")
  archiveArtifacts       DocumentArchiveJobArtifact[]    @relation("DocumentArchiveArtifactDocument")
  analyses               DocumentAnalysisCache[]         @relation("StoredDocumentAnalyses")
  expensePaymentProofs   Expense[]                       @relation("ExpensePaymentProof")
  // B8 — bons de commande scannés référencés par devis/factures (FK composite anti-IDOR).
  purchaseOrderQuotes    Quote[]                         @relation("QuotePurchaseOrderDocument")
  purchaseOrderInvoices  Invoice[]                       @relation("InvoicePurchaseOrderDocument")

  @@unique([companyId, id], name: "uniq_stored_document_company_id", map: "uniq_stored_document_company_id")
  @@index([companyId, kind])
  @@index([companyId, folderId, createdAt])
  @@index([companyId, linkedEntityType, linkedEntityId])
  @@index([companyId, retentionUntil])
  @@map("documents")
}

/**
 * Cache append-only d'une analyse documentaire validée. La clé inclut le tenant,
 * la version logique, l'empreinte de l'original ET la version de contrat JSON :
 * un résultat publié n'est jamais remplacé silencieusement — une évolution du contrat
 * (analysisSchemaVersion) publie une NOUVELLE ligne, l'historique reste intact.
 */
model DocumentAnalysisCache {
  companyId             String
  documentId            String
  document              StoredDocument        @relation("StoredDocumentAnalyses", fields: [companyId, documentId], references: [companyId, id], onDelete: Cascade, onUpdate: Cascade)
  documentVersion       Int
  sourceSha256          String                @db.Char(64)
  sourceVersion         StoredDocumentVersion @relation("StoredDocumentVersionAnalyses", fields: [documentId, documentVersion, sourceSha256], references: [documentId, version, sha256], onDelete: Cascade, onUpdate: Cascade)
  analyzerVersion       String
  analysisSchemaVersion Int                   @default(1)
  analysis              Json
  analyzedAt            DateTime              @db.Timestamptz(6)

  @@id([companyId, documentId, documentVersion, sourceSha256, analysisSchemaVersion], name: "document_analysis_cache_key", map: "document_analyses_pkey")
  @@map("document_analyses")
}

model DocumentFolder {
  id             String                       @id
  companyId      String
  company        Company                      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  parentId       String?
  parent         DocumentFolder?              @relation("DocumentFolderHierarchy", fields: [companyId, parentId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade)
  children       DocumentFolder[]             @relation("DocumentFolderHierarchy")
  documents      StoredDocument[]             @relation("StoredDocumentFolder")
  deletionPlans  DocumentFolderDeletionPlan[]
  name           String
  normalizedName String
  systemKey      String?
  status         DocumentFolderStatus         @default(active)
  revision       Int                          @default(1)
  createdAt      DateTime
  updatedAt      DateTime
  deletedAt      DateTime?

  @@unique([companyId, id], name: "uniq_document_folder_company_id")
  @@unique([companyId, systemKey], name: "uniq_document_folder_system_key")
  @@index([companyId, parentId, status])
  @@map("document_folders")
}

model DocumentFolderDeletionPlan {
  id               String         @id
  companyId        String
  company          Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  folderId         String
  folder           DocumentFolder @relation(fields: [companyId, folderId], references: [companyId, id], onDelete: Restrict, onUpdate: Cascade)
  expectedRevision Int
  expectedSnapshot Json
  createdAt        DateTime
  expiresAt        DateTime
  consumedAt       DateTime?

  @@index([companyId, expiresAt])
  @@index([expiresAt])
  @@map("document_folder_deletion_plans")
}

model StoredDocumentVersion {
  id                     String                          @id
  documentId             String
  document               StoredDocument                  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version                Int
  storageKey             String                          @unique
  sha256                 String                          @db.Char(64)
  analyses               DocumentAnalysisCache[]         @relation("StoredDocumentVersionAnalyses")
  archiveArtifacts       DocumentArchiveJobArtifact[]    @relation("DocumentArchiveArtifactVersion")
  invoicePdfAttestations DocumentInvoicePdfAttestation[] @relation("InvoicePdfAttestationVersion")
  mimeType               String
  byteSize               Int
  createdAt              DateTime
  reason                 String

  @@unique([documentId, version])
  @@unique([documentId, id], name: "uniq_document_version_document_id", map: "uniq_document_version_document_id")
  @@unique([documentId, version, sha256], name: "uniq_document_version_source", map: "uniq_document_version_source")
  @@index([documentId])
  @@map("document_versions")
}

/**
 * Attestation byte-derived immuable d'un PDF de facture généré.
 */
model DocumentInvoicePdfAttestation {
  companyId         String
  documentId        String
  document          StoredDocument        @relation("InvoicePdfAttestationDocument", fields: [companyId, documentId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict)
  versionId         String
  version           StoredDocumentVersion @relation("InvoicePdfAttestationVersion", fields: [documentId, versionId], references: [documentId, id], onDelete: Restrict, onUpdate: Restrict)
  documentSha256    String                @db.Char(64)
  profile           String
  embeddedXmlSha256 String?               @db.Char(64)
  detectorVersion   Int
  attestedAt        DateTime              @default(now()) @db.Timestamptz(6)

  @@id([documentId, versionId], name: "document_invoice_pdf_attestations_pkey")
  @@index([companyId, documentId])
  @@map("document_invoice_pdf_attestations")
}

model DocumentArchiveJob {
  id                   String                       @id
  companyId            String
  company              Company                      @relation(fields: [companyId], references: [id])
  invoiceId            String
  reason               String                       @default("invoice-issued")
  status               DocumentArchiveJobStatus     @default(pending)
  attempts             Int                          @default(0)
  nextAttemptAt        DateTime
  leaseToken           String?                      @unique
  lastError            String?
  integrityProof       Json?
  integrityProofSha256 String?                      @db.Char(64)
  completedAt          DateTime?                    @db.Timestamptz(6)
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  artifacts            DocumentArchiveJobArtifact[]

  @@unique([companyId, invoiceId, reason], name: "uniq_document_archive_job")
  @@unique([id, companyId], name: "uniq_document_archive_job_company", map: "uniq_document_archive_job_company")
  @@index([companyId, status, nextAttemptAt])
  @@map("document_archive_jobs")
}

/**
 * Projection relationnelle du manifeste de clôture d'archive. Les champs sont des snapshots
 * exacts des originaux relus ; les FK composites empêchent une preuve de référencer une autre
 * société, un autre document ou une version qui n'appartient pas au document annoncé.
 */
model DocumentArchiveJobArtifact {
  jobId          String
  companyId      String
  job            DocumentArchiveJob    @relation(fields: [jobId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Restrict)
  kind           String
  contentProfile String
  documentId     String
  document       StoredDocument        @relation("DocumentArchiveArtifactDocument", fields: [companyId, documentId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict)
  versionId      String
  version        StoredDocumentVersion @relation("DocumentArchiveArtifactVersion", fields: [documentId, versionId], references: [documentId, id], onDelete: Restrict, onUpdate: Restrict)
  versionNumber  Int
  storageKey     String
  mimeType       String
  byteSize       Int
  sha256         String                @db.Char(64)
  createdAt      DateTime              @default(now()) @db.Timestamptz(6)

  @@id([jobId, kind], name: "document_archive_job_artifacts_pkey")
  @@unique([jobId, documentId], name: "uniq_document_archive_job_artifact_document")
  @@unique([jobId, versionId], name: "uniq_document_archive_job_artifact_version")
  @@index([companyId, jobId])
  @@map("document_archive_job_artifacts")
}

model NotificationJob {
  id                  String                @id
  companyId           String
  company             Company               @relation(fields: [companyId], references: [id])
  kind                String
  dedupeKey           String
  channel             String
  recipient           String
  subject             String
  payload             Json?
  payloadFingerprint  String?
  status              NotificationJobStatus @default(pending)
  attempts            Int                   @default(0)
  nextAttemptAt       DateTime
  leaseToken          String?
  providerAttemptedAt DateTime?
  lastError           String?
  readAt              DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@unique([companyId, kind, dedupeKey], name: "uniq_notification_job")
  @@index([companyId, status, nextAttemptAt])
  @@index([companyId, createdAt(sort: Desc)], map: "notification_jobs_recent_idx")
  // Index partiel due+payload défini dans la migration leaseToken : Prisma 6 ne sait pas
  // représenter son prédicat WHERE sans perdre la certification SQL PostgreSQL.
  @@map("notification_jobs")
}

// Appareils enregistrés pour le push Expo (C25) — un token appartient à une seule session
// applicative à la fois, tous tenants confondus. Le repository effectue un rebind atomique sous RLS.
model PushInstallation {
  id                   String    @id @db.Uuid
  revocationSecretHash String    @db.Char(64)
  // High-water mark conservé même après révocation du device actif : un ancien POST ne peut
  // jamais ressusciter le binding précédent après logout ou reconnexion.
  maxGeneration        Int
  currentBindingId     String?   @unique(map: "push_installations_current_binding_id_key") @db.Uuid
  currentCompanyId     String?
  currentUserId        String?
  lastConfirmedAt      DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  device               Device?

  @@map("push_installations")
}

model Device {
  id                   String            @id
  companyId            String
  company              Company           @relation(fields: [companyId], references: [id])
  userId               String?
  expoPushToken        String            @unique(map: "devices_expo_push_token_key")
  platform             String?
  // Phase expand : nullable pour les lignes N-1. Toute inscription N porte ensuite une
  // installation stable et un binding one-shot, afin qu'une révocation tardive ne supprime
  // jamais le binding du compte suivant sur le même téléphone.
  installationId       String?           @unique(map: "devices_installation_id_key") @db.Uuid
  installation         PushInstallation? @relation(fields: [installationId], references: [id], onDelete: Restrict)
  bindingId            String?           @unique(map: "devices_binding_id_key") @db.Uuid
  bindingGeneration    Int?
  revocationSecretHash String?           @db.Char(64)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  // Compatibilité rolling N-1 : l'ancien binaire cible encore cette clé composée. La contrainte
  // globale ci-dessus fait foi ; cette clé redondante sera retirée dans une phase contract ultérieure.
  @@unique([companyId, expoPushToken], name: "uniq_device_token", map: "devices_companyId_expoPushToken_key")
  @@index([companyId])
  @@map("devices")
}

// Journal append-only des actions agentiques exécutées par Bob.
// Une entrée = une intention/audit factuel ; l'application n'expose ni update ni delete.
model AgentJournalEntry {
  id           String               @id
  companyId    String
  company      Company              @relation(fields: [companyId], references: [id])
  runId        String
  seq          Int
  at           DateTime
  phase        AgentJournalPhase
  tool         String
  label        String
  args         Json
  mutating     Boolean
  outbound     Boolean
  compliance   AgentComplianceLevel
  reason       String?
  resultDigest String?
  createdAt    DateTime             @default(now())

  @@unique([companyId, runId, seq], name: "uniq_agent_journal_seq")
  @@index([companyId, runId])
  @@index([companyId, at])
  @@map("agent_journal_entries")
}

model AccountingAccount {
  companyId      String
  company        Company               @relation(fields: [companyId], references: [id])
  code           String
  label          String
  kind           AccountingAccountKind
  normalSide     AccountingNormalSide
  parentCode     String?
  active         Boolean               @default(true)
  postingAllowed Boolean               @default(true)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@id([companyId, code])
  @@index([companyId, parentCode])
  @@index([companyId, active, postingAllowed])
  @@map("accounting_accounts")
}

model AccountingEntry {
  id         String                @id
  companyId  String
  company    Company               @relation(fields: [companyId], references: [id])
  journal    AccountingJournal
  sourceType AccountingSourceType
  sourceId   String
  entryDate  String
  reference  String
  label      String
  createdAt  DateTime              @default(now())
  lines      AccountingEntryLine[]

  @@unique([id, companyId], name: "uniq_accounting_entry_id_company")
  @@index([companyId, journal, entryDate])
  @@index([companyId, sourceType, sourceId])
  @@map("accounting_entries")
}

model AccountingEntryLine {
  id          String          @id
  companyId   String
  entryId     String
  entry       AccountingEntry @relation(fields: [entryId, companyId], references: [id, companyId], onDelete: Cascade)
  position    Int
  account     String
  label       String
  debitCents  Int
  creditCents Int

  @@unique([entryId, position], name: "uniq_accounting_entry_line_position")
  @@index([companyId, account])
  @@map("accounting_entry_lines")
}

// Numérotation sans trou : INSERT ... ON CONFLICT DO UPDATE +1 RETURNING (atomique).
model DocumentCounter {
  companyId  String
  company    Company @relation(fields: [companyId], references: [id])
  counterKey String
  fiscalYear Int
  nextValue  Int     @default(1)

  @@id([companyId, counterKey, fiscalYear])
  @@map("document_counters")
}

/// Journal glissant des réservations Bob Live admises. Le subject utilisateur est un HMAC
/// SHA-256 hex ; aucun userId brut ni jeton de bail ne doit entrer dans cette table.
model RealtimeAdmissionEvent {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @db.Text
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  subjectHash String   @db.Char(64)
  sessionId   String   @unique(map: "realtime_admission_events_session_id_key") @db.Uuid
  admittedAt  DateTime @db.Timestamptz(6)

  @@index([companyId, admittedAt], map: "realtime_admission_events_tenant_window_idx")
  @@index([companyId, subjectHash, admittedAt], map: "realtime_admission_events_subject_window_idx")
  @@map("realtime_admission_events")
}

/// Bail distribué unique par tenant + sujet. Le token 256 bits reste dans le processus qui l'a
/// créé ; seule son empreinte SHA-256 permet les transitions CAS reserve/bind/activate/renew/release.
model RealtimeSessionLease {
  companyId                   String    @db.Text
  company                     Company   @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  subjectHash                 String    @db.Char(64)
  sessionId                   String    @unique(map: "realtime_session_leases_session_id_key") @db.Uuid
  leaseTokenHash              String    @unique(map: "realtime_session_leases_token_hash_key") @db.Char(64)
  state                       String    @db.Text
  // Identité du transport distante. Les deux champs restent NULL uniquement pendant `reserved`.
  providerId                  String?   @db.Text
  providerCallId              String?   @db.Text
  reaperTokenHash             String?   @unique(map: "realtime_session_leases_reaper_token_hash_key") @db.Char(64)
  reservedAt                  DateTime  @db.Timestamptz(6)
  leaseExpiresAt              DateTime  @db.Timestamptz(6)
  hardExpiresAt               DateTime  @db.Timestamptz(6)
  activatedAt                 DateTime? @db.Timestamptz(6)
  // Snapshot écran éphémère, validé par @bob/ai. Il disparaît avec le bail et n'autorise rien.
  contextSchemaVersion        Int?
  contextRevision             Int?
  contextPayload              Json?
  contextDigest               String?   @db.Char(64)
  contextUpdatedAt            DateTime? @db.Timestamptz(6)
  // Le sideband est un bail distinct : seul son token hashé permet les renouvellements CAS.
  sidebandOwnerInstanceHash   String?   @db.Char(64)
  sidebandOwnerTokenHash      String?   @unique(map: "realtime_session_leases_sideband_owner_token_hash_key") @db.Char(64)
  sidebandOwnerLeaseExpiresAt DateTime? @db.Timestamptz(6)
  sidebandOwnerEpoch          Int       @default(0)
  // ACK du contexte effectivement appliqué par le sideband propriétaire. Il peut retarder
  // la révision publiée, mais doit la rejoindre avant toute publication audio ou action.
  contextAppliedRevision      Int?
  contextAppliedDigest        String?   @db.Char(64)
  contextAppliedAt            DateTime? @db.Timestamptz(6)
  contextAppliedOwnerEpoch    Int?
  sidebandProtocolVersion     Int       @default(2)
  nextSpeechSequence          Int       @default(1)
  updatedAt                   DateTime  @db.Timestamptz(6)
  version                     Int       @default(1)

  @@id([companyId, subjectHash], name: "realtime_session_lease_subject")
  @@unique([providerId, providerCallId], map: "realtime_session_leases_provider_call_identity_key")
  @@index([companyId, state, leaseExpiresAt], map: "realtime_session_leases_tenant_reaper_idx")
  @@index([state, leaseExpiresAt], map: "realtime_session_leases_global_reaper_idx")
  @@index([hardExpiresAt], map: "realtime_session_leases_hard_expiry_idx")
  @@map("realtime_session_leases")
}

/// Autorité globale privée de capacité Bob Live. Le runtime ne reçoit aucun accès SQL direct :
/// préflight et métrologie passent exclusivement par deux fonctions SECURITY DEFINER bornées.
model RealtimeGlobalCapacity {
  id                  Int       @id @default(1)
  mode                String    @default("tracking") @db.Text
  providerId          String?   @db.Text
  providerModel       String?   @db.Text
  globalMaxSessions   Int?
  providerMaxSessions Int?
  configVersion       Int?
  retryAfterSeconds   Int?
  usedSessions        Int
  revision            BigInt    @default(0)
  activatedAt         DateTime? @db.Timestamptz(6)
  updatedAt           DateTime  @db.Timestamptz(6)

  @@map("realtime_global_capacity")
}

/// Capacité one-shot du WSS PCM Mistral. Le ticket 256 bits et le userId restent absents de la
/// base : seuls le SHA-256 du ticket et une identité AEAD liée au bail/contexte sont persistés.
/// Les lignes terminales sont conservées un temps borné même après suppression du bail provider.
model RealtimeMistralIngressTicket {
  id                           String    @id @default(uuid()) @db.Uuid
  companyId                    String    @db.Text
  company                      Company   @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  subjectHash                  String    @db.Char(64)
  subjectKeyVersion            Int
  sessionId                    String    @db.Uuid
  ticketHash                   String    @unique(map: "realtime_mistral_ingress_tickets_ticket_hash_key") @db.Char(64)
  protocol                     String    @db.Text
  state                        String    @db.Text
  plan                         String    @db.Text
  contextSchemaVersion         Int
  contextRevision              Int
  contextDigest                String    @db.Char(64)
  userIdentityCiphertext       Bytes
  userIdentityNonce            Bytes
  userIdentityTag              Bytes
  identityEncryptionKeyVersion Int
  maxAudioBytes                Int
  providerSessionId            String?   @unique(map: "realtime_mistral_ingress_tickets_provider_session_key") @db.Text
  providerTermination          String?   @db.Text
  issuedAt                     DateTime  @db.Timestamptz(6)
  ticketExpiresAt              DateTime  @db.Timestamptz(6)
  bindingExpiresAt             DateTime? @db.Timestamptz(6)
  hardExpiresAt                DateTime  @db.Timestamptz(6)
  consumedAt                   DateTime? @db.Timestamptz(6)
  activatedAt                  DateTime? @db.Timestamptz(6)
  finishedAt                   DateTime? @db.Timestamptz(6)
  retentionExpiresAt           DateTime  @db.Timestamptz(6)
  version                      Int       @default(1)

  @@unique([companyId, sessionId], map: "realtime_mistral_ingress_tickets_session_key")
  @@index([companyId, state, ticketExpiresAt], map: "realtime_mistral_ingress_tickets_tenant_state_idx")
  @@index([companyId, issuedAt], map: "realtime_mistral_ingress_tickets_tenant_issued_idx")
  @@index([companyId, retentionExpiresAt], map: "realtime_mistral_ingress_tickets_retention_idx")
  @@map("realtime_mistral_ingress_tickets")
}

/// Capacité initiale HTTP -> WSS de Bob Live Mistral v2. Le ticket brut et le userId sont absents
/// de la base : seuls un hash domain-separated et une identité AEAD liée au bail sont persistés.
/// Le seul update runtime autorisé est issued(v1) -> consumed(v2), après création atomique de la
/// Mission et de son événement `session.ready` par l'autorité PostgreSQL.
model RealtimeMistralConversationBootstrapTicket {
  id                           String                                    @id @default(uuid()) @db.Uuid
  companyId                    String                                    @db.Text
  company                      Company                                   @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  admissionSessionId           String                                    @unique(map: "mistral_conversation_bootstrap_admission_key") @db.Uuid
  sessionHandle                String                                    @db.Text
  subjectHash                  String                                    @db.Char(64)
  subjectKeyVersion            Int
  admissionLeaseTokenHash      String                                    @db.Char(64)
  ticketHash                   String                                    @unique(map: "mistral_conversation_bootstrap_ticket_hash_key") @db.Char(64)
  protocol                     String                                    @db.Text
  state                        String                                    @db.Text
  plan                         String                                    @db.Text
  contextSchemaVersion         Int
  contextRevision              Int
  contextSnapshot              Json
  contextDigest                String                                    @db.Char(64)
  userIdentityCiphertext       Bytes
  userIdentityNonce            Bytes
  userIdentityTag              Bytes
  identityEncryptionKeyVersion Int
  routeMode                    String                                    @db.Text
  fullDuplexCertified          Boolean
  maxMissionAudioBytes         Int
  issuedAt                     DateTime                                  @db.Timestamptz(6)
  ticketExpiresAt              DateTime                                  @db.Timestamptz(6)
  leaseExpiresAt               DateTime                                  @db.Timestamptz(6)
  hardExpiresAt                DateTime                                  @db.Timestamptz(6)
  consumedAt                   DateTime?                                 @db.Timestamptz(6)
  retentionExpiresAt           DateTime                                  @db.Timestamptz(6)
  version                      Int                                       @default(1)
  updatedAt                    DateTime                                  @default(now()) @db.Timestamptz(6)
  reconciliationResumeTickets  RealtimeMistralConversationResumeTicket[] @relation("MistralBootstrapReconciliationResumeTickets")
  mission                      RealtimeMistralConversationMission?       @relation("MistralMissionInitialBootstrap")

  @@unique([id, companyId], map: "mistral_conversation_bootstrap_tenant_binding")
  @@unique([companyId, ticketHash], map: "mistral_conversation_bootstrap_tenant_ticket_key")
  @@index([companyId, issuedAt], map: "mistral_conversation_bootstrap_tenant_issued_idx")
  @@index([companyId, subjectHash, issuedAt], map: "mistral_conversation_bootstrap_subject_issued_idx")
  @@index([companyId, retentionExpiresAt], map: "mistral_conversation_bootstrap_retention_idx")
  @@map("realtime_mistral_conversation_bootstrap_tickets")
}

/// Snapshot transactionnel de la mission conversationnelle Mistral v2. Les compteurs wire
/// utilisent BIGINT car le curseur terminal UINT32_MAX + 1 dépasse un INTEGER PostgreSQL.
/// Le token d'owner 256 bits ne quitte jamais le processus : seule son empreinte SHA-256 vit ici.
model RealtimeMistralConversationMission {
  id                         String                                     @id @default(uuid()) @db.Uuid
  companyId                  String                                     @db.Text
  company                    Company                                    @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  initialBootstrapId         String                                     @unique(map: "realtime_mistral_conversation_missions_bootstrap_key") @db.Uuid
  initialBootstrap           RealtimeMistralConversationBootstrapTicket @relation("MistralMissionInitialBootstrap", fields: [initialBootstrapId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Cascade)
  // Référence typée au bail d'admission initial. Nullable uniquement pour les missions v2
  // historiques créées avant le déploiement des capacités de reprise : elles échouent fermées.
  admissionSessionId         String?                                    @unique(map: "realtime_mistral_conversation_missions_admission_session_key") @db.Uuid
  protocol                   String                                     @db.Text
  subjectHash                String                                     @db.Char(64)
  subjectKeyVersion          Int
  plan                       String                                     @db.Text
  sessionHandle              String                                     @db.Text
  ownerTokenHash             String                                     @unique(map: "realtime_mistral_conversation_missions_owner_token_key") @db.Char(64)
  ownerAcquiredAt            DateTime                                   @db.Timestamptz(6)
  missionConnectionEpoch     Int
  version                    BigInt                                     @default(1)
  acknowledgedServerSequence BigInt                                     @default(0)
  retainedFromServerSequence BigInt                                     @default(0)
  nextServerSequence         BigInt
  nextProviderSequence       BigInt                                     @default(0)
  snapshotSchemaVersion      Int                                        @default(1)
  phase                      String                                     @db.Text
  contextRevision            Int
  contextDigest              String                                     @db.Char(64)
  routeMode                  String                                     @db.Text
  fullDuplexCertified        Boolean
  maxMissionAudioBytes       Int
  audioBytes                 Int                                        @default(0)
  missionState               Json
  turnState                  Json?
  finalTranscriptRecorded    Boolean                                    @default(false)
  terminalReason             String?                                    @db.Text
  terminalServerSequence     BigInt?
  closedAt                   DateTime?                                  @db.Timestamptz(6)
  hardExpiresAt              DateTime                                   @db.Timestamptz(6)
  replayGraceExpiresAt       DateTime                                   @db.Timestamptz(6)
  retentionExpiresAt         DateTime                                   @db.Timestamptz(6)
  createdAt                  DateTime                                   @db.Timestamptz(6)
  updatedAt                  DateTime                                   @db.Timestamptz(6)
  outbox                     RealtimeMistralConversationOutboxEvent[]
  commands                   RealtimeMistralConversationCommand[]
  resumeTickets              RealtimeMistralConversationResumeTicket[]

  @@unique([initialBootstrapId, companyId], map: "mistral_conversation_mission_bootstrap_tenant_key")
  @@unique([companyId, sessionHandle], map: "realtime_mistral_conversation_missions_session_key")
  @@unique([id, companyId, sessionHandle], map: "realtime_mistral_conversation_missions_tenant_binding")
  @@unique([id, companyId, sessionHandle, admissionSessionId], map: "realtime_mistral_conversation_missions_admission_binding")
  @@index([companyId, phase, hardExpiresAt], map: "realtime_mistral_conversation_missions_tenant_reaper_idx")
  @@index([retentionExpiresAt], map: "realtime_mistral_conversation_missions_retention_idx")
  @@map("realtime_mistral_conversation_missions")
}

/// Preuve terminale minimale, immuable et sans contenu utilisateur. Elle survit à la purge de la
/// Mission afin qu'une reprise tardive puisse distinguer une fermeture certaine d'une session
/// inconnue. Seule la suppression de la Company entraîne sa suppression en cascade.
model RealtimeMistralConversationTerminalReceipt {
  companyId              String   @db.Text
  company                Company  @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  sessionHandle          String   @db.Text
  subjectHash            String   @db.Char(64)
  subjectKeyVersion      Int
  protocol               String   @db.Text
  missionConnectionEpoch Int
  nextServerSequence     BigInt
  terminalReason         String   @db.Text
  closedAt               DateTime @db.Timestamptz(6)
  createdAt              DateTime @default(now()) @db.Timestamptz(6)

  @@id([companyId, sessionHandle], map: "mistral_terminal_receipt_pkey")
  @@map("realtime_mistral_conversation_terminal_receipts")
}

/// Capacité HTTP -> WSS one-shot dédiée à la reprise Mistral v2. Le ticket brut et le token de
/// connexion ne sont jamais persistés : seuls leurs SHA-256 vivent ici. Une consommation réussie
/// est atomique avec le takeover ou le replay terminal de la mission liée.
model RealtimeMistralConversationResumeTicket {
  id                                   String                                      @id @default(uuid()) @db.Uuid
  companyId                            String                                      @db.Text
  company                              Company                                     @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  missionId                            String                                      @db.Uuid
  mission                              RealtimeMistralConversationMission          @relation(fields: [missionId, companyId, sessionHandle, admissionSessionId], references: [id, companyId, sessionHandle, admissionSessionId], onDelete: Cascade, onUpdate: Cascade)
  purpose                              String                                      @default("standard_resume") @db.Text
  initialBootstrapId                   String?                                     @db.Uuid
  initialBootstrap                     RealtimeMistralConversationBootstrapTicket? @relation("MistralBootstrapReconciliationResumeTickets", fields: [initialBootstrapId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Cascade)
  reconciliationAttempt                Int?
  reconciliationKeyVersion             Int?
  sessionHandle                        String                                      @db.Text
  admissionSessionId                   String                                      @db.Uuid
  ticketHash                           String                                      @unique(map: "realtime_mistral_conversation_resume_tickets_hash_key") @db.Char(64)
  protocol                             String                                      @db.Text
  scope                                String                                      @db.Text
  state                                String                                      @db.Text
  subjectHash                          String                                      @db.Char(64)
  subjectKeyVersion                    Int
  plan                                 String                                      @db.Text
  expectedMissionConnectionEpoch       Int
  clientAcceptedMissionConnectionEpoch Int
  resumeNextServerSequence             BigInt
  contextRevision                      Int
  contextDigest                        String                                      @db.Char(64)
  routeMode                            String                                      @db.Text
  fullDuplexCertified                  Boolean
  maxMissionAudioBytes                 Int
  hardExpiresAt                        DateTime                                    @db.Timestamptz(6)
  replayGraceExpiresAt                 DateTime                                    @db.Timestamptz(6)
  issuedAt                             DateTime                                    @db.Timestamptz(6)
  expiresAt                            DateTime                                    @db.Timestamptz(6)
  consumedAt                           DateTime?                                   @db.Timestamptz(6)
  consumedMissionConnectionEpoch       Int?
  replayConnectionId                   String?                                     @unique(map: "mistral_resume_tickets_replay_connection_key") @db.Uuid
  connectionLeaseTokenHash             String?                                     @unique(map: "mistral_resume_tickets_connection_token_key") @db.Char(64)
  connectionLeaseExpiresAt             DateTime?                                   @db.Timestamptz(6)
  maxAcknowledgableServerSequence      BigInt?
  retentionExpiresAt                   DateTime                                    @db.Timestamptz(6)
  version                              Int                                         @default(1)

  @@unique([companyId, initialBootstrapId, reconciliationAttempt], map: "mistral_resume_reconciliation_attempt_key")
  @@index([companyId, initialBootstrapId, state, expiresAt], map: "mistral_resume_reconciliation_state_idx")
  @@index([companyId, missionId, state, expiresAt], map: "realtime_mistral_conversation_resume_tickets_mission_state_idx")
  @@index([companyId, ticketHash, protocol], map: "realtime_mistral_conversation_resume_tickets_lookup_idx")
  @@index([companyId, subjectHash, missionId, state, expiresAt], map: "realtime_mistral_conversation_resume_tickets_subject_state_idx")
  @@index([companyId, retentionExpiresAt], map: "realtime_mistral_conversation_resume_tickets_retention_idx")
  @@map("realtime_mistral_conversation_resume_tickets")
}

/// Événement wire v2 rejouable. Le JSON canonique, qui peut contenir un transcript, est chiffré
/// AES-256-GCM ; aucune parole ni commande brute n'est persistée en clair.
model RealtimeMistralConversationOutboxEvent {
  companyId            String                             @db.Text
  missionId            String                             @db.Uuid
  sessionHandle        String                             @db.Text
  serverSequence       BigInt
  eventType            String                             @db.Text
  payloadCiphertext    Bytes
  payloadNonce         Bytes
  payloadTag           Bytes
  encryptionKeyVersion Int
  payloadBytes         Int
  createdAt            DateTime                           @db.Timestamptz(6)
  retentionExpiresAt   DateTime                           @db.Timestamptz(6)
  mission              RealtimeMistralConversationMission @relation(fields: [missionId, companyId, sessionHandle], references: [id, companyId, sessionHandle], onDelete: Cascade, onUpdate: Cascade)

  @@id([companyId, sessionHandle, serverSequence], name: "realtime_mistral_conversation_outbox_sequence")
  @@index([missionId, companyId, sessionHandle], map: "realtime_mistral_conversation_outbox_mission_idx")
  @@index([retentionExpiresAt], map: "realtime_mistral_conversation_outbox_retention_idx")
  @@map("realtime_mistral_conversation_outbox")
}

/// Ledger append-only des commandes v2. L'identifiant est hashé et le payload est attesté par
/// HMAC versionné ; la plage outbox permet un replay exact sans conserver la commande sensible.
model RealtimeMistralConversationCommand {
  companyId              String                             @db.Text
  missionId              String                             @db.Uuid
  sessionHandle          String                             @db.Text
  commandIdHash          String                             @db.Char(64)
  commandType            String                             @db.Text
  commandPayloadHmac     String                             @db.Char(64)
  proofKeyVersion        Int
  missionConnectionEpoch Int
  snapshotVersionBefore  BigInt
  snapshotVersionAfter   BigInt
  firstServerSequence    BigInt
  eventCount             Int
  createdAt              DateTime                           @db.Timestamptz(6)
  retentionExpiresAt     DateTime                           @db.Timestamptz(6)
  mission                RealtimeMistralConversationMission @relation(fields: [missionId, companyId, sessionHandle], references: [id, companyId, sessionHandle], onDelete: Cascade, onUpdate: Cascade)

  @@id([companyId, sessionHandle, commandIdHash], name: "realtime_mistral_conversation_command_idempotency")
  @@index([missionId, companyId, sessionHandle], map: "realtime_mistral_conversation_commands_mission_idx")
  @@index([retentionExpiresAt], map: "realtime_mistral_conversation_commands_retention_idx")
  @@map("realtime_mistral_conversation_commands")
}

/// Registre global (non tenant, sans secret) des plages de clés de persistance Mistral et HMAC
/// sujet Bob Live. Chaque famille reste isolée par keySpace et monotone sous triggers SQL.
model RealtimeMistralConversationKeyVersionFloor {
  keySpace       String   @id(map: "mistral_key_floor_pkey") @db.VarChar(64)
  minimumVersion Int
  highestVersion Int
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @db.Timestamptz(6)

  @@map("realtime_mistral_conversation_key_version_floors")
}

/// Engagement SHA-256 append-only du matériau associé à chaque version et keySpace. L'empreinte
/// n'est pas un secret ; elle empêche toute réutilisation silencieuse d'un numéro avec une autre clé.
model RealtimeMistralConversationKeyBinding {
  keySpace       String   @db.VarChar(64)
  keyVersion     Int
  keyFingerprint String   @db.Char(64)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  @@id([keySpace, keyVersion], name: "mistral_key_binding_pkey")
  @@unique([keySpace, keyFingerprint], map: "mistral_key_binding_fingerprint_key")
  @@map("realtime_mistral_conversation_key_bindings")
}

/// Plage globale des versions AEAD admises pour toute nouvelle preuve bootstrap. Le registre est
/// distinct de la persistance Mission/r2 afin que leurs writers et rétentions restent indépendants.
model RealtimeMistralConversationIdentityKeyVersionFloor {
  keySpace       String   @id(map: "mistral_identity_key_floor_pkey") @db.VarChar(64)
  minimumVersion Int
  highestVersion Int
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @db.Timestamptz(6)

  @@map("realtime_mistral_conversation_identity_key_version_floors")
}

/// Engagement SHA-256 append-only d'une version de clé identité. Aucun secret n'est stocké.
model RealtimeMistralConversationIdentityKeyBinding {
  keySpace       String   @db.VarChar(64)
  keyVersion     Int
  keyFingerprint String   @db.Char(64)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  @@id([keySpace, keyVersion], name: "mistral_identity_key_binding_pkey")
  @@unique([keySpace, keyFingerprint], map: "mistral_identity_key_binding_fingerprint_key")
  @@map("realtime_mistral_conversation_identity_key_bindings")
}

/// Segment audio Bob Live rendu hors du canal WebRTC descendant. La base ne conserve ni texte,
/// ni transcription, ni audio : seulement des HMAC de preuve et la clé d'un objet privé éphémère.
/// Les transitions et l'immuabilité des preuves sont imposées par triggers SQL.
model RealtimeSpeechArtifact {
  id                     String                @id @default(uuid()) @db.Uuid
  companyId              String                @db.Text
  company                Company               @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  subjectHash            String                @db.Char(64)
  sessionId              String                @db.Uuid
  turnId                 String                @db.Uuid
  sequence               Int                   @default(0)
  segmentIndex           Int
  renderTokenHash        String                @unique(map: "realtime_speech_artifacts_render_token_hash_key") @db.Char(64)
  sidebandOwnerEpoch     Int
  sidebandOwnerTokenHash String                @db.Char(64)
  state                  String                @db.Text
  classification         String                @db.Text
  source                 String?               @db.Text
  contextRevision        Int
  contextDigest          String                @db.Char(64)
  storageKey             String?               @db.Text
  storageExpiresAt       DateTime?             @db.Timestamptz(6)
  mimeType               String?               @db.Text
  byteLength             Int?
  durationMs             Int?
  canonicalSpeechHmac    String                @db.Char(64)
  auditTranscriptHmac    String?               @db.Char(64)
  factsHmac              String                @db.Char(64)
  evidenceHmac           String?               @db.Char(64)
  audioSha256            String?               @db.Char(64)
  proofKeyVersion        Int?
  synthesisAdapterId     String?               @db.Text
  synthesisTrustDomain   String?               @db.Text
  auditAdapterId         String?               @db.Text
  auditTrustDomain       String?               @db.Text
  renderLeaseExpiresAt   DateTime?             @db.Timestamptz(6)
  deliveryId             String?               @unique(map: "realtime_speech_artifacts_delivery_id_key") @db.Uuid
  cancellationId         String?               @unique(map: "realtime_speech_artifacts_cancellation_id_key") @db.Uuid
  cancellationReasonCode String?               @db.Text
  failureReasonCode      String?               @db.Text
  objectPurgedAt         DateTime?             @db.Timestamptz(6)
  purgeTokenHash         String?               @unique(map: "realtime_speech_artifacts_purge_token_hash_key") @db.Char(64)
  purgeLeaseExpiresAt    DateTime?             @db.Timestamptz(6)
  createdAt              DateTime              @db.Timestamptz(6)
  updatedAt              DateTime              @db.Timestamptz(6)
  readyAt                DateTime?             @db.Timestamptz(6)
  deliveredAt            DateTime?             @db.Timestamptz(6)
  cancelledAt            DateTime?             @db.Timestamptz(6)
  failedAt               DateTime?             @db.Timestamptz(6)
  retentionExpiresAt     DateTime              @db.Timestamptz(6)
  version                Int                   @default(1)
  controlGrant           RealtimeControlGrant?

  @@unique([companyId, sessionId, sequence], name: "realtime_speech_artifact_session_sequence")
  @@unique([companyId, sessionId, turnId, segmentIndex], name: "realtime_speech_artifact_turn_segment")
  @@unique([id, companyId, sessionId, turnId], name: "realtime_speech_artifact_tenant_binding")
  @@unique([storageKey], name: "realtime_speech_artifact_storage_key")
  @@index([companyId, sessionId, state, sequence], map: "realtime_speech_artifacts_session_state_idx")
  @@index([state, renderLeaseExpiresAt], map: "realtime_speech_artifacts_render_reaper_idx")
  @@index([companyId, retentionExpiresAt], map: "realtime_speech_artifacts_retention_idx")
  @@map("realtime_speech_artifacts")
}

/// Preuve bornée d'une restitution audio OpenAI Realtime native. Ni audio, ni texte canonique,
/// ni transcription ne sont persistés : uniquement des empreintes HMAC, des dimensions
/// allowlistées et des timestamps. `dispatching` est le claim durable at-most-once posé avant
/// `response.create` ; un résultat réseau ambigu ne peut donc jamais être rejoué aveuglément.
model RealtimeNativeSpeechDelivery {
  deliveryId                            String                @id @default(uuid()) @db.Uuid
  companyId                             String                @db.Text
  company                               Company               @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "realtime_native_speech_deliveries_company_fkey")
  subjectHmac                           String                @db.Char(64)
  /// NULL uniquement pour les lignes N-1 créées avant la rotation durable. Tout nouveau writer
  /// renseigne une version admise et liée ; aucun backfill ne peut inventer la clé historique.
  subjectKeyVersion                     Int?
  sessionId                             String                @db.Uuid
  turnId                                String                @db.Uuid
  contextRevision                       Int
  contextDigest                         String                @db.Char(64)
  sidebandOwnerEpoch                    Int
  sidebandOwnerTokenHmac                String                @db.Char(64)
  /// Version de la politique de risque déterministe ayant autorisé le RTP natif.
  speechPolicyVersion                   Int
  /// Scénario générique exact et allowlisté ; jamais un intent ou un libellé fourni par le LLM.
  speechScenarioId                      String                @db.Text
  canonicalSpeechHmac                   String                @db.Char(64)
  factsHmac                             String                @db.Char(64)
  requestNonceHmac                      String                @unique(map: "realtime_native_speech_deliveries_request_nonce_hmac_key") @db.Char(64)
  proofFormatVersion                    Int
  proofKeyVersion                       Int
  provider                              String                @db.Text
  model                                 String                @db.Text
  voice                                 String                @db.Text
  version                               Int                   @default(1)
  revision                              Int                   @default(1)
  phase                                 String                @db.Text
  dispatchClaimId                       String?               @unique(map: "realtime_native_speech_deliveries_dispatch_claim_id_key") @db.Uuid
  dispatchingAt                         DateTime?             @db.Timestamptz(3)
  requestedAt                           DateTime?             @db.Timestamptz(3)
  providerResponseIdHmac                String?               @db.Char(64)
  acceptedAt                            DateTime?             @db.Timestamptz(3)
  streamingAt                           DateTime?             @db.Timestamptz(3)
  responseDoneAt                        DateTime?             @db.Timestamptz(3)
  outputStoppedAt                       DateTime?             @db.Timestamptz(3)
  outputTranscriptHmac                  String?               @db.Char(64)
  completedAt                           DateTime?             @db.Timestamptz(3)
  acknowledgementId                     String?               @unique(map: "realtime_native_speech_deliveries_acknowledgement_id_key") @db.Uuid
  deliveredAt                           DateTime?             @db.Timestamptz(3)
  /// Version de l'observation locale attachée au premier ACK. V1 = RTP distant observé + provider drainé, jamais DAC.
  localObservationFormatVersion         Int?
  /// Type allowlisté de l'observation locale ; aucun détail device ni identifiant fournisseur.
  localObservationKind                  String?               @db.Text
  /// Version du lot de métrologie attaché atomiquement au premier ACK. NULL = aucun lot fourni.
  sloFormatVersion                      Int?
  /// Réception device de `speech_stopped` au premier paquet RTP entrant, en millisecondes.
  speechStoppedEventToFirstInboundRtpMs Int?
  /// `complete` conserve les mesures exactes ; `overflowed` interdit une moyenne biaisée.
  bargeInStatus                         String?               @db.Text
  /// Maximum 16 latences exactes, sans contenu ni identifiant fournisseur.
  bargeInDurationsMs                    Int[]                 @default([])
  cancellationId                        String?               @unique(map: "realtime_native_speech_deliveries_cancellation_id_key") @db.Uuid
  cancellationReason                    String?               @db.Text
  failureId                             String?               @unique(map: "realtime_native_speech_deliveries_failure_id_key") @db.Uuid
  failureReason                         String?               @db.Text
  terminalAt                            DateTime?             @db.Timestamptz(3)
  createdAt                             DateTime              @db.Timestamptz(3)
  expiresAt                             DateTime              @db.Timestamptz(3)
  retentionExpiresAt                    DateTime              @db.Timestamptz(3)
  controlGrant                          RealtimeControlGrant?

  @@unique([companyId, sessionId, turnId], name: "realtime_native_speech_delivery_turn", map: "realtime_native_speech_deliveries_turn_key")
  @@unique([deliveryId, companyId, sessionId, turnId], name: "realtime_native_speech_delivery_tenant_binding", map: "realtime_native_speech_deliveries_tenant_binding_key")
  @@unique([provider, providerResponseIdHmac], map: "realtime_native_speech_deliveries_provider_response_key")
  @@index([companyId, sessionId, phase, createdAt], map: "realtime_native_speech_deliveries_session_phase_idx")
  @@index([companyId, retentionExpiresAt], map: "realtime_native_speech_deliveries_retention_idx")
  @@index([subjectKeyVersion], map: "realtime_native_speech_deliveries_subject_key_version_idx")
  @@map("realtime_native_speech_deliveries")
}

/// Gate global monotone de compatibilité rolling. Le runtime applicatif ne le manipule jamais :
/// le trigger d'insertion le lit sous verrou sujet, et le rituel propriétaire le ferme une fois.
model RealtimeNativeLegacySubjectAdmission {
  gate      String    @id @db.Text
  phase     String    @db.Text
  revision  Int
  createdAt DateTime  @db.Timestamptz(6)
  closedAt  DateTime? @db.Timestamptz(6)

  @@map("realtime_native_legacy_subject_admission")
  @@ignore
}

/// Curseur global purement technique du scan keyset de maintenance. Le runtime ne possède aucun
/// droit direct sur cette table ; seul le helper SECURITY DEFINER borné peut lire/avancer ses deux
/// lignes. `@@ignore` empêche toute dérive vers un accès Prisma applicatif.
model RealtimeNativeSpeechMaintenanceCursor {
  lane            String    @id @db.Text
  afterDueAt      DateTime? @db.Timestamptz(6)
  afterCompanyId  String?   @db.Text
  afterDeliveryId String?   @db.Uuid
  cycleUpperDueAt      DateTime? @db.Timestamptz(6)
  cycleUpperCompanyId  String?   @db.Text
  cycleUpperDeliveryId String?   @db.Uuid
  pendingCompanyIds      String[]  @default([])
  pendingAfterDueAt      DateTime? @db.Timestamptz(6)
  pendingAfterCompanyId  String?   @db.Text
  pendingAfterDeliveryId String?   @db.Uuid
  pendingHasMore         Boolean?
  claimId                String?   @db.Uuid
  claimExpiresAt         DateTime? @db.Timestamptz(6)
  revision        BigInt    @default(0)

  @@ignore
  @@map("realtime_native_speech_maintenance_cursors")
}

/// Projection conservative du prochain travail reaper. Les triggers N-1/N ne déplacent un minimum
/// que vers le passé ; le reaper tenanté réconcilie ensuite la valeur exacte sous advisory lock.
model RealtimeReaperTenantSchedule {
  companyId          String    @id @db.Text
  oldestAdmissionAt  DateTime? @db.Timestamptz(6)
  nextLeaseDueAt     DateTime? @db.Timestamptz(6)
  revision           BigInt    @default(0)

  @@ignore
  @@map("realtime_reaper_tenant_schedule")
}

/// Curseur technique du reaper provider-neutral. Les pages dues sont louées et ACKées par une
/// fonction SECURITY DEFINER minimale ; aucun repository applicatif n'accède directement ici.
model RealtimeReaperDirectoryCursor {
  singleton                      Boolean   @id @default(true)
  afterAdmissionCompanyId        String?   @db.Text
  cycleUpperAdmissionCompanyId   String?   @db.Text
  cycleAdmissionCutoffAt         DateTime? @db.Timestamptz(6)
  afterLeaseCompanyId            String?   @db.Text
  cycleUpperLeaseCompanyId       String?   @db.Text
  cycleLeaseCutoffAt             DateTime? @db.Timestamptz(6)
  preferLease                    Boolean   @default(true)
  pendingCompanyIds              String[]  @default([])
  pendingAfterAdmissionCompanyId String?  @db.Text
  pendingAfterLeaseCompanyId     String?  @db.Text
  pendingAdmissionHasMore        Boolean?
  pendingLeaseHasMore            Boolean?
  pendingPreferLease             Boolean?
  claimId                        String?   @db.Uuid
  claimExpiresAt                 DateTime? @db.Timestamptz(6)
  revision                       BigInt    @default(0)

  @@ignore
  @@map("realtime_reaper_directory_cursor")
}

/// Action UI opaque, chiffrée et liée par XOR à une seule preuve de livraison acoustique. Le
/// défaut `audited_artifact`/v1 conserve byte-for-byte les writers historiques ; le domaine
/// `provider_stream`/v2 reste séparé. Une grant ne peut jamais être modifiée.
model RealtimeControlGrant {
  id                   String                        @id @default(uuid()) @db.Uuid
  companyId            String                        @db.Text
  company              Company                       @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sessionId            String                        @db.Uuid
  turnId               String                        @db.Uuid
  deliveryKind         String                        @default("audited_artifact") @db.Text
  bindingVersion       Int                           @default(1)
  artifactId           String?                       @db.Uuid
  artifact             RealtimeSpeechArtifact?       @relation(fields: [artifactId, companyId, sessionId, turnId], references: [id, companyId, sessionId, turnId], onDelete: Restrict, onUpdate: Cascade)
  nativeDeliveryId     String?                       @db.Uuid
  nativeDelivery       RealtimeNativeSpeechDelivery? @relation(fields: [nativeDeliveryId, companyId, sessionId, turnId], references: [deliveryId, companyId, sessionId, turnId], onDelete: Restrict, onUpdate: Cascade, map: "realtime_control_grants_native_delivery_tenant_fkey")
  contextRevision      Int
  contextDigest        String                        @db.Char(64)
  controlKind          String                        @db.Text
  sealedControl        Bytes
  controlNonce         Bytes
  controlTag           Bytes
  controlPayloadHmac   String                        @db.Char(64)
  encryptionKeyVersion Int
  proofKeyVersion      Int
  issuedAt             DateTime                      @db.Timestamptz(6)
  expiresAt            DateTime                      @db.Timestamptz(6)
  retentionExpiresAt   DateTime                      @db.Timestamptz(6)
  consumption          RealtimeControlConsumption?

  @@unique([companyId, sessionId, turnId], name: "realtime_control_grant_turn")
  @@unique([companyId, artifactId], name: "realtime_control_grant_artifact")
  @@unique([artifactId, companyId, sessionId, turnId], name: "realtime_control_grant_artifact_binding")
  @@unique([companyId, nativeDeliveryId], name: "realtime_control_grant_native_delivery", map: "realtime_control_grants_native_delivery_key")
  @@unique([nativeDeliveryId, companyId, sessionId, turnId], name: "realtime_control_grant_native_delivery_binding", map: "realtime_control_grants_native_delivery_binding_key")
  @@unique([id, companyId, sessionId, turnId], name: "realtime_control_grant_tenant_binding")
  @@index([companyId, sessionId, expiresAt], map: "realtime_control_grants_session_expiry_idx")
  @@index([companyId, retentionExpiresAt], map: "realtime_control_grants_retention_idx")
  @@map("realtime_control_grants")
}

/// Preuve one-shot d'une validation de contrôle. La PK rend la consommation unique par grant et
/// acknowledgementId apporte l'idempotence des retries client sans jamais rouvrir la grant.
model RealtimeControlConsumption {
  companyId          String               @db.Text
  company            Company              @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  grantId            String               @db.Uuid
  acknowledgementId  String               @db.Uuid
  sessionId          String               @db.Uuid
  turnId             String               @db.Uuid
  grant              RealtimeControlGrant @relation(fields: [grantId, companyId, sessionId, turnId], references: [id, companyId, sessionId, turnId], onDelete: Restrict, onUpdate: Cascade)
  consumedAt         DateTime             @db.Timestamptz(6)
  retentionExpiresAt DateTime             @db.Timestamptz(6)

  @@id([companyId, grantId], name: "realtime_control_consumption_grant")
  @@unique([companyId, acknowledgementId], name: "realtime_control_consumption_ack")
  @@unique([grantId, companyId, sessionId, turnId], name: "realtime_control_consumption_binding")
  @@index([companyId, sessionId, consumedAt], map: "realtime_control_consumptions_session_idx")
  @@index([companyId, retentionExpiresAt], map: "realtime_control_consumptions_retention_idx")
  @@map("realtime_control_consumptions")
}

/// Mesure d'usage append-only et dédupliquée. Elle ne contient aucun contenu vocal, seulement
/// des compteurs bornés et une clé d'idempotence HMAC versionnée.
model RealtimeVoiceUsageEvent {
  id                 String   @id @default(uuid()) @db.Uuid
  companyId          String   @db.Text
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  subjectHash        String   @db.Char(64)
  subjectKeyVersion  Int
  sessionId          String   @db.Uuid
  turnId             String?  @db.Uuid
  dedupeKeyHmac      String   @db.Char(64)
  proofKeyVersion    Int
  plan               String   @db.Text
  kind               String   @db.Text
  source             String   @db.Text
  amount             Decimal  @db.Decimal(20, 6)
  occurredAt         DateTime @db.Timestamptz(6)
  recordedAt         DateTime @db.Timestamptz(6)
  retentionExpiresAt DateTime @db.Timestamptz(6)

  @@unique([companyId, dedupeKeyHmac], name: "realtime_voice_usage_event_dedupe")
  @@index([companyId, occurredAt], map: "realtime_voice_usage_events_tenant_time_idx")
  @@index([companyId, sessionId, occurredAt], map: "realtime_voice_usage_events_session_time_idx")
  @@index([companyId, retentionExpiresAt], map: "realtime_voice_usage_events_retention_idx")
  @@map("realtime_voice_usage_events")
}

/// Agrégat journalier monotone, alimenté exclusivement par le trigger d'insertion des événements.
/// Les timestamps sont explicites : aucun @updatedAt implicite dans ce registre de facturation.
model RealtimeVoiceUsageDaily {
  companyId          String   @db.Text
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  usageDate          DateTime @db.Date
  subjectHash        String   @db.Char(64)
  subjectKeyVersion  Int
  plan               String   @db.Text
  kind               String   @db.Text
  source             String   @db.Text
  amount             Decimal  @db.Decimal(26, 6)
  eventCount         BigInt   @default(0)
  firstEventAt       DateTime @db.Timestamptz(6)
  lastEventAt        DateTime @db.Timestamptz(6)
  aggregatedAt       DateTime @db.Timestamptz(6)
  retentionExpiresAt DateTime @db.Timestamptz(6)
  version            Int      @default(1)

  @@id([companyId, usageDate, subjectHash, subjectKeyVersion, plan, kind, source], name: "realtime_voice_usage_daily_dimension")
  @@index([companyId, retentionExpiresAt], map: "realtime_voice_usage_daily_retention_idx")
  @@map("realtime_voice_usage_daily")
}

// Espace Cabinet V3 — tenant distinct de Company. Les identités sont des subject IDs Supabase ;
// le JWT prouve l'identité, mais CabinetMember reste l'unique source d'autorisation.
model Cabinet {
  id                   String                      @id
  name                 String
  timeZone             String                      @default("Europe/Paris")
  status               CabinetStatus               @default(active)
  createdByUserId      String
  bootstrapCompletedAt DateTime?
  version              Int                         @default(1)
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  members              CabinetMember[]
  adminGuard           CabinetAdminGuard?
  invitations          CabinetInvitation[]
  invitationDeliveries CabinetInvitationDelivery[]
  auditEvents          CabinetAuditEvent[]
  dossiers             CabinetDossier[]

  @@index([createdByUserId])
  @@index([status])
  @@map("cabinets")
}

model CabinetMember {
  id                 String              @id
  cabinetId          String
  cabinet            Cabinet             @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  userId             String
  sourceInvitationId String?
  // La FK réelle est DEFERRABLE/NO ACTION dans la migration : une suppression privilégiée du
  // cabinet efface invitations + memberships dans la même transaction sans muter cette provenance.
  sourceInvitation   CabinetInvitation?  @relation("MembershipSourceInvitation", fields: [sourceInvitationId, cabinetId], references: [id, cabinetId], onDelete: NoAction, onUpdate: NoAction)
  role               CabinetRole
  status             CabinetMemberStatus @default(active)
  joinedAt           DateTime            @default(now())
  suspendedAt        DateTime?
  revokedAt          DateTime?
  version            Int                 @default(1)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  issuedInvitations  CabinetInvitation[] @relation("CabinetInvitationInviter")
  revokedInvitations CabinetInvitation[] @relation("CabinetInvitationRevoker")

  @@unique([id, cabinetId], name: "uniq_cabinet_member_id_cabinet")
  // Unicité des memberships non révoquées gérée par index partiel SQL (Prisma ne l'exprime pas).
  @@index([cabinetId, userId])
  @@index([userId, status])
  @@index([cabinetId, status, role])
  @@map("cabinet_members")
}

// Compteur interne sérialisé par ligne. Aucun port applicatif ne l'expose ; les triggers
// SECURITY DEFINER garantissent qu'un cabinet finalisé conserve toujours un admin actif.
model CabinetAdminGuard {
  cabinetId   String   @id
  cabinet     Cabinet  @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  activeCount Int
  updatedAt   DateTime @updatedAt

  @@map("cabinet_admin_guards")
}

model CabinetInvitation {
  id                String                      @id
  cabinetId         String
  cabinet           Cabinet                     @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  emailNormalized   String
  role              CabinetRole
  status            CabinetInvitationStatus     @default(pending)
  tokenHash         String                      @unique @db.Char(64)
  expiresAt         DateTime
  invitedByMemberId String
  invitedByMember   CabinetMember               @relation("CabinetInvitationInviter", fields: [invitedByMemberId, cabinetId], references: [id, cabinetId], onDelete: NoAction, onUpdate: NoAction)
  acceptedByUserId  String?
  acceptedAt        DateTime?
  revokedAt         DateTime?
  revokedByMemberId String?
  revokedByMember   CabinetMember?              @relation("CabinetInvitationRevoker", fields: [revokedByMemberId, cabinetId], references: [id, cabinetId], onDelete: NoAction, onUpdate: NoAction)
  version           Int                         @default(1)
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  deliveries        CabinetInvitationDelivery[]
  joinedMembers     CabinetMember[]             @relation("MembershipSourceInvitation")

  @@unique([id, cabinetId], name: "uniq_cabinet_invitation_id_cabinet")
  @@index([cabinetId, status, expiresAt])
  @@index([emailNormalized, status])
  @@index([invitedByMemberId])
  @@index([revokedByMemberId])
  @@map("cabinet_invitations")
}

// Outbox durable. Le jeton est chiffré par AEAD puis les colonnes secrètes sont purgées après
// livraison. La rotation de clé attend le drainage des jobs de la version précédente.
model CabinetInvitationDelivery {
  id              String                          @id
  cabinetId       String
  cabinet         Cabinet                         @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  invitationId    String
  invitation      CabinetInvitation               @relation(fields: [invitationId, cabinetId], references: [id, cabinetId], onDelete: Cascade, onUpdate: NoAction)
  dedupeKey       String
  tokenCiphertext String?
  tokenIv         String?
  tokenAuthTag    String?
  tokenKeyVersion Int                             @default(1)
  status          CabinetInvitationDeliveryStatus @default(pending)
  attempts        Int                             @default(0)
  nextAttemptAt   DateTime
  lockedAt        DateTime?
  leaseUntil      DateTime?
  lastError       String?
  sentAt          DateTime?
  createdAt       DateTime                        @default(now())
  updatedAt       DateTime                        @updatedAt

  @@unique([cabinetId, dedupeKey], name: "uniq_cabinet_invitation_delivery")
  @@index([cabinetId, status, nextAttemptAt])
  @@index([invitationId])
  @@map("cabinet_invitation_deliveries")
}

/// Analyse FEC dérivée et validée d'un dossier cabinet. Le FEC brut n'est jamais persisté ici :
/// le JSON contient uniquement les états structurés, protégés par empreinte et révision CAS.
model CabinetDossier {
  id                          String   @id
  cabinetId                   String
  cabinet                     Cabinet  @relation(fields: [cabinetId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  siren                       String   @db.VarChar(9)
  clientName                  String   @db.VarChar(200)
  sourceFileName              String   @db.VarChar(255)
  entryCount                  Int
  rowCount                    Int
  periodFrom                  DateTime @db.Date
  periodTo                    DateTime @db.Date
  turnoverCents               BigInt
  resultCents                 BigInt
  totalDebitCents             BigInt
  totalCreditCents            BigInt
  trialBalanceBalanced        Boolean
  balanceSheetBalanced        Boolean
  statementsConsistent        Boolean
  balanceSheetDifferenceCents BigInt
  analysis                    Json
  analysisSha256              String   @db.Char(64)
  review                      Json?
  fiscal                      Json
  lastImportedAt              DateTime @db.Timestamptz(3)
  revision                    Int      @default(1)
  createdAt                   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt                   DateTime @updatedAt @db.Timestamptz(3)

  @@unique([cabinetId, siren], name: "cabinet_dossier_siren", map: "cabinet_dossiers_cabinetId_siren_key")
  @@index([cabinetId, updatedAt(sort: Desc), id(sort: Desc)], map: "cabinet_dossiers_cabinetId_updatedAt_id_idx")
  @@map("cabinet_dossiers")
}

// Journal de sécurité append-only côté rôle runtime. Le payload ne contient jamais de jeton brut.
model CabinetAuditEvent {
  id            String   @id
  cabinetId     String
  cabinet       Cabinet  @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  actorUserId   String
  action        String
  entityType    String
  entityId      String
  payload       Json     @default("{}")
  correlationId String?
  createdAt     DateTime @default(now())

  @@index([cabinetId, createdAt])
  @@index([cabinetId, entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("cabinet_audit_events")
}

// Les release flags sont des rails de déploiement, distincts des entitlements tarifaires.
// killSwitch domine toute valeur globale ou ciblée. Une absence/erreur d'évaluation vaut false.
model ReleaseFlag {
  id              String                  @id
  key             String
  environment     ReleaseEnvironment
  enabled         Boolean                 @default(false)
  killSwitch      Boolean                 @default(false)
  version         Int                     @default(1)
  updatedByUserId String
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  subjects        ReleaseFlagSubject[]
  auditEvents     ReleaseFlagAuditEvent[]

  @@unique([key, environment], name: "uniq_release_flag_key_environment")
  @@index([environment, enabled, killSwitch])
  @@map("release_flags")
}

// Journal ops global : aucune policy runtime. Seul le rôle privilégié/CI peut écrire/lire.
model ReleaseFlagAuditEvent {
  id          String      @id
  flagId      String
  flag        ReleaseFlag @relation(fields: [flagId], references: [id], onDelete: Restrict)
  actor       String
  reason      String
  operation   String
  beforeState Json
  afterState  Json
  createdAt   DateTime    @default(now())

  @@index([flagId, createdAt])
  @@index([actor, createdAt])
  @@map("release_flag_audit_events")
}

model ReleaseFlagSubject {
  id              String                 @id
  flagId          String
  flag            ReleaseFlag            @relation(fields: [flagId], references: [id], onDelete: Cascade)
  subjectType     ReleaseFlagSubjectType
  subjectId       String
  enabled         Boolean
  version         Int                    @default(1)
  updatedByUserId String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@unique([flagId, subjectType, subjectId], name: "uniq_release_flag_subject")
  @@index([subjectType, subjectId])
  @@map("release_flag_subjects")
}

// Pilier 2 (monétisation) — état d'abonnement PERSISTÉ par tenant, source de vérité derrière
// GetSubscriptionStatus (@bob/core). Une ligne par company (essai inversé démarré au
// provisioning, cf. backend.service.registerCompany) ; `plan` porte le palier grante MAINTENANT
// (cf. commentaire de l'enum SubscriptionPlan). `store=none` porte un accès anticipé/gracieux
// explicitement persisté ; aucune absence de ligne ne confère de droit implicite.
model Subscription {
  id                   String             @id
  companyId            String             @unique
  company              Company            @relation(fields: [companyId], references: [id])
  plan                 SubscriptionPlan
  status               SubscriptionStatus @default(trialing)
  trialEndsAt          DateTime?
  currentPeriodEnd     DateTime?
  store                SubscriptionStore?
  storeRef             String?
  stripeCustomerId     String?
  stripeSubscriptionId String?
  stripeLastEventId    String?
  stripeLastSyncedAt   DateTime?          @db.Timestamptz(6)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  // Les deux index uniques partiels Stripe sont définis dans la migration
  // 20260717100000_stripe_billing_reconciliation (le DSL Prisma ne porte pas leur prédicat).

  @@map("subscriptions")
}

// Profil fiscal (BOB EXPERT FISCAL, Phase 1A — SPEC_EXPERT_FISCAL.md §V2 point 2). Une ligne par
// company (companyId unique), créée par GetFiscalProfile (@bob/core) à la première lecture via
// dérivation d'hypothèses depuis la forme juridique.
//
// SHAPE CHOISIE : un colonne JSON PAR CHAMP FiscalDatum<T> (legalForm, taxRegime, socialStatus,
// activityNature, vatRegime, acre, versementLiberatoire, fiscalYearEnd), chacune portant le
// STATUT + valeur + horodatage + source sérialisés tels quels (ex. {"status":"hypothese",
// "value":"micro","updatedAt":"...","source":"derived_legal_form"} ou {"status":"manquant"}).
// Justification (vs colonnes typées + 4 colonnes de méta par champ = ~32 colonnes) :
// · l'union discriminée FiscalDatum (statut 'manquant' SANS `value`) mappe directement en JSON,
//   alors que des colonnes typées forceraient soit des colonnes nullable dupliquées par champ
//   (valeur/statut/updatedAt/source), soit une table de lignes séparée bien plus lourde pour un
//   agrégat aussi plat ;
// · évite de créer 5 nouveaux enums Postgres (taxRegime/socialStatus/activityNature/vatRegime +
//   AcreInfo/FiscalYearEnd en sous-objets) pour une donnée encore en évolution rapide (V1→V2→V3
//   de la spec) — le domaine (@bob/core) reste la SEULE source de vérité des valeurs autorisées ;
// · chaque champ reste individuellement adressable (PATCH /fiscal-profile/:field = UPDATE d'UNE
//   colonne), donc pas de perte de granularité vs des colonnes typées.
// Précédent dans ce schéma : `signatureProof Json?` (Quote), `vatByRate Json` — JSON déjà utilisé
// pour des sous-structures polymorphes/évolutives plutôt que d'exploser les colonnes.
model FiscalProfile {
  id                   String   @id
  companyId            String   @unique
  company              Company  @relation(fields: [companyId], references: [id])
  legalForm            Json
  taxRegime            Json
  socialStatus         Json
  activityNature       Json
  vatRegime            Json
  acre                 Json
  versementLiberatoire Json
  fiscalYearEnd        Json
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("fiscal_profiles")
}

/// TRACE DE COMPORTEMENT VOCAL — une ligne par TOUR de conversation (bêta-test fondateur).
///
/// Objet : comprendre et REPRODUIRE ce que fait Bob à la voix. Une ligne raconte le fil complet
/// d'un tour : ce qui a été dit → ce que Bob a compris → l'outil qu'il a choisi et avec quels
/// paramètres → l'issue → ce qu'il a répondu → le temps de chaque étape.
///
/// SOUVERAINETÉ. `transcript` et `reply` portent les données les plus sensibles de l'app (noms de
/// clients, montants, SIRET). Elles restent ICI, dans notre PostgreSQL, sous RLS FORCE : jamais
/// chez un observateur tiers — ce sont exactement les données déjà exclues de la télémétrie de
/// plantage pour motif RGPD (packages/core/src/observability/telemetry-scrubbing.ts).
///
/// RÉTENTION BORNÉE. Debug de bêta-test, pas archive légale : `retentionExpiresAt` (30 jours)
/// est purgé par VoiceTracePurgeService. Aucune obligation de conservation ne s'y attache.
///
/// DORMANT PAR DÉFAUT : aucune ligne n'est écrite sans VOICE_TRACE_ENABLED=true.
model VoiceTrace {
  id                 String   @id @db.Text
  companyId          String   @db.Text
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  /// Session vocale reconstruite côté serveur (le tour traverse 3 requêtes HTTP distinctes).
  sessionId          String   @db.Text
  turnIndex          Int
  /// Identité du testeur : suivi du comportement des testeurs, sans jointure vers un profil.
  userId             String?  @db.Text
  /// correlationId HTTP de la requête qui a OUVERT le tour (transcription) — recolle les logs.
  correlationId      String   @db.Text
  /// correlationId de la requête de planification (/ai/ask), différent du précédent.
  planCorrelationId  String?  @db.Text
  startedAt          DateTime @db.Timestamptz(6)
  /// Ce qui a été prononcé, tel que transcrit. Borné, jamais rédigé (cf. SOUVERAINETÉ).
  transcript         String?  @db.Text
  sttModel           String?  @db.Text
  /// Ce que Bob a compris : intention résolue par le routeur, puis outil retenu et paramètres.
  intent             String?  @db.Text
  tool               String?  @db.Text
  toolArgs           Json?
  autonomy           String?  @db.Text
  llmModel           String?  @db.Text
  /// heard | success | refused | error (VoiceTurnOutcome, @bob/core).
  outcome            String   @db.Text
  /// info | warn | error (VoiceTraceLevel). `error` seul remonte au canal d'incident.
  level              String   @db.Text
  /// Raison LISIBLE d'un refus métier ou d'une anomalie. Null quand le tour a abouti.
  reason             String?  @db.Text
  /// Ce que Bob a répondu, tel qu'il l'aurait prononcé.
  reply              String?  @db.Text
  ttsModel           String?  @db.Text
  transcriptionMs    Int?
  planificationMs    Int?
  executionMs        Int?
  syntheseMs         Int?
  updatedAt          DateTime @db.Timestamptz(6)
  retentionExpiresAt DateTime @db.Timestamptz(6)

  @@unique([companyId, sessionId, turnIndex], name: "voice_trace_turn")
  @@index([companyId, startedAt], map: "voice_traces_tenant_time_idx")
  @@index([companyId, level, startedAt], map: "voice_traces_level_idx")
  @@index([companyId, retentionExpiresAt], map: "voice_traces_retention_idx")
  @@map("voice_traces")
}
