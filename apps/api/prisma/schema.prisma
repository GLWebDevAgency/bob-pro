// Bob Pro — schéma Postgres (source de vérité financière). Aligné sur le blueprint §6.2.
// IDs applicatifs (String) fournis par le domaine (UuidGenerator / fixtures).

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum LegalForm {
  EI
  EURL
  SASU
  SARL
  SAS
  micro
}

enum VatRegime {
  franchise
  reel_simpl
  reel_normal
}

enum CustomerType {
  b2c
  b2b
  b2g
}

enum DocKind {
  quote
  invoice
  deposit_invoice
  credit_note
  situation
}

enum QuoteStatus {
  draft
  sent
  viewed
  signed
  refused
  expired
}

enum InvoiceStatus {
  draft
  issued
  partially_paid
  paid
  late
  cancelled
}

enum LineCategory {
  labor
  supply
  travel
  disbursement
  subscription
}

enum PaymentMethod {
  card
  transfer
  cash
}

model Company {
  id              String   @id
  name            String
  legalForm       LegalForm
  siren           String   @db.Char(9)
  siret           String   @unique @db.Char(14)
  apeCode         String?
  trade           String
  vatRegime       VatRegime
  rcsOrRm         String?
  addrLine1       String
  addrZip         String
  addrCity        String
  iban            String?
  bic             String?
  insurerName     String?
  policyNo        String?
  coverage        String?
  policyExpiresAt DateTime?
  customers       Customer[]
  quotes          Quote[]
  invoices        Invoice[]
  payments        Payment[]
  counters        DocumentCounter[]
  @@map("companies")
}

model Customer {
  id            String   @id
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  type          CustomerType
  name          String
  siren         String?  @db.Char(9)
  isInternational Boolean @default(false)
  addrLine1     String
  addrZip       String
  addrCity      String
  email         String?
  phone         String?
  ptLabel       String?
  score         Int      @default(0)
  avgDelayDays  Int      @default(0)
  outstanding   Int      @default(0)
  isSubcontractingBtp Boolean @default(false)
  @@index([companyId])
  @@index([companyId, type])
  @@map("customers")
}

model Quote {
  id            String   @id
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  customerId    String
  status        QuoteStatus @default(draft)
  number        String?
  validUntil    DateTime?
  depositPct    Int?
  signerName    String?
  signedAt      DateTime?
  totalsHt      Int      @default(0)
  totalsVat     Int      @default(0)
  totalsTtc     Int      @default(0)
  totalsNetToPay Int     @default(0)
  vatByRate     Json     @default("{}")
  lines         LineItem[] @relation("QuoteLines")
  @@unique([companyId, number], name: "uniq_quote_number")
  @@index([companyId, status])
  @@map("quotes")
}

model Invoice {
  id            String   @id
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  customerId    String
  kind          DocKind
  status        InvoiceStatus @default(draft)
  number        String?
  issuedAt      DateTime?
  dueAt         DateTime?
  parentQuoteId String?
  depositPct    Int?
  paidCents     Int      @default(0)
  totalsHt      Int      @default(0)
  totalsVat     Int      @default(0)
  totalsTtc     Int      @default(0)
  totalsNetToPay Int     @default(0)
  vatByRate     Json     @default("{}")
  legalMentions String[] @default([])
  lines         LineItem[] @relation("InvoiceLines")
  payments      Payment[]
  @@unique([companyId, number], name: "uniq_invoice_number")
  @@index([companyId, status])
  @@index([dueAt])
  @@map("invoices")
}

model LineItem {
  id          String   @id @default(uuid())
  quoteId     String?
  quote       Quote?   @relation("QuoteLines", fields: [quoteId], references: [id])
  invoiceId   String?
  invoice     Invoice? @relation("InvoiceLines", fields: [invoiceId], references: [id])
  position    Int
  label       String
  category    LineCategory
  qty         Decimal  @db.Decimal(12, 3)
  unit        String?
  unitPriceHt Int
  vatRate     Decimal  @db.Decimal(4, 2)
  @@index([quoteId])
  @@index([invoiceId])
  @@map("line_items")
}

model Payment {
  id         String   @id
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  invoiceId  String
  invoice    Invoice  @relation(fields: [invoiceId], references: [id])
  amount     Int
  method     PaymentMethod
  receivedAt DateTime
  @@index([invoiceId])
  @@map("payments")
}

// Numérotation sans trou : INSERT ... ON CONFLICT DO UPDATE +1 RETURNING (atomique).
model DocumentCounter {
  companyId  String
  company    Company @relation(fields: [companyId], references: [id])
  counterKey String
  fiscalYear Int
  nextValue  Int     @default(1)
  @@id([companyId, counterKey, fiscalYear])
  @@map("document_counters")
}
