{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@bob/core": ["../../packages/core/src/index.ts"],
      "@bob/core/testing": ["../../packages/core/src/testing.ts"],
      "@bob/ai": ["../../packages/ai/src/index.ts"],
      "@bob/ai/testing": ["../../packages/ai/src/testing.ts"]
    },
    "outDir": "dist",
    "declaration": false,
    "sourceMap": true
  },
  "include": ["src"]
}
