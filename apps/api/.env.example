# Bob Pro API — variables d'environnement
NODE_ENV=development
PORT=3000

# Serveur live par défaut. DEMO_MODE=true est réservé aux tests de composition qui injectent leurs
# propres ports ; il ne désactive jamais JWT/RLS et n'active aucune donnée synthétique.
DEMO_MODE=false

# IA (clés JAMAIS sur le device — uniquement ici). En live, au moins un fournisseur est requis.
ANTHROPIC_API_KEY=
GLM_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
# Bob Live — profils stricts, sans clé fournisseur croisée :
# - `mistral` : entrée Voxtral Realtime + sortie Voxtral TTS, MISTRAL_API_KEY uniquement ;
# - `openai` : entrée OpenAI Realtime + sortie OpenAI TTS, OPENAI_API_KEY uniquement.
# L'audit acoustique `local-whisper` est auto-hébergé dans les deux profils. Il utilise un
# jeton interne dédié et évite qu'un fournisseur certifie lui-même sa propre sortie audio.
BOB_LIVE_ENABLED=false
BOB_LIVE_PROVIDER=mistral
BOB_LIVE_SUBJECT_HMAC_SECRET=
BOB_LIVE_SUBJECT_KEY_VERSION=1
# Requis pour Mistral v2. JSON {"1":"secret-HMAC"}; conserver toute version encore référencée
# par une Mission ou un reçu terminal. La clé courante doit égaler le secret ci-dessus.
BOB_LIVE_SUBJECT_HMAC_KEYRING=
BOB_LIVE_PROOF_SECRET=
BOB_LIVE_PROOF_KEY_VERSION=1
# Clé HMAC dédiée aux événements d'usage/idempotence ; ne jamais la partager avec la preuve audio.
BOB_LIVE_USAGE_HMAC_SECRET=
BOB_LIVE_USAGE_KEY_VERSION=1
BOB_LIVE_CONTROL_ENCRYPTION_SECRET=
BOB_LIVE_CONTROL_ENCRYPTION_KEY_VERSION=1
# Canary de reprise v2 : terminal seulement. Laisser false tant que les migrations et la
# certification PostgreSQL ne sont pas passées sur l'environnement cible.
BOB_LIVE_MISTRAL_V2_TERMINAL_REPLAY_ENABLED=false
BOB_LIVE_MISTRAL_V2_INITIAL_BOOTSTRAP_ENABLED=false
# Le reaper est automatiquement obligatoire dès que le replay terminal v2 est actif. Chaque
# réplique peut le lancer : la fonction PostgreSQL arbitre les batches avec SKIP LOCKED.
BOB_LIVE_MISTRAL_V2_BOOTSTRAP_REAPER_INTERVAL_MS=60000
BOB_LIVE_MISTRAL_V2_BOOTSTRAP_REAPER_BATCH_SIZE=10
BOB_LIVE_MISTRAL_V2_BOOTSTRAP_REAPER_MAX_BATCHES=4
# Keyring AEAD dédié aux identités du bootstrap Mistral v2, distinct des clés contrôle/persistence.
# Paire obligatoire pour activer le bootstrap ; la conserver avec le replay terminal pendant un
# rollback afin de drainer/réconcilier les preuves déjà scellées. Maximum 8 clés de 32 octets.
# BOB_LIVE_MISTRAL_V2_IDENTITY_ENCRYPTION_KEY_VERSION=1
# BOB_LIVE_MISTRAL_V2_IDENTITY_ENCRYPTION_KEYRING={"1":"<43-caractères-base64url>"}
# Objet JSON compact, par exemple {"1":"<43 caractères base64url = 32 octets>"}.
# Garder les anciennes versions jusqu'à expiration/purge de toutes leurs missions.
# Rotation sans coupure : release.sh prépare d'abord la nouvelle version ; le workflow CD ne
# retire l'ancienne qu'après readiness de la nouvelle révision et extinction de l'ancien replica.
# Le rôle DATABASE_URL ne peut jamais modifier ce registre, seul DIRECT_URL le peut au déploiement.
# BOB_LIVE_MISTRAL_V2_PERSISTENCE_KEY_VERSION=1
# BOB_LIVE_MISTRAL_V2_PERSISTENCE_KEYRING={"1":"<43-caractères-base64url>"}
BOB_LIVE_PROVIDER_TIMEOUT_MS=4000
BOB_LIVE_CONTROL_TIMEOUT_MS=3000
BOB_LIVE_MAX_SESSION_SECONDS=900
BOB_LIVE_MAX_CALLS_PER_MINUTE=3
BOB_LIVE_MAX_CALLS_PER_HOUR=30
BOB_LIVE_MAX_TENANT_CALLS_PER_MINUTE=50
BOB_LIVE_MAX_TENANT_CALLS_PER_HOUR=1000
BOB_LIVE_RESERVATION_TTL_SECONDS=15
BOB_LIVE_ACTIVE_LEASE_SECONDS=30
BOB_LIVE_HEARTBEAT_SECONDS=10
BOB_LIVE_REAPER_LEASE_SECONDS=30
# Budget local avant authentification durable. À dimensionner sous la capacité DB/provider.
BOB_LIVE_GATEWAY_MAX_CONNECTIONS=500
BOB_LIVE_GATEWAY_SHUTDOWN_GRACE_MS=1500
# `direct` exige TLS sur le socket Node. `trusted-proxy` n'est sûr que si le backend est
# inaccessible directement et si le reverse proxy écrase X-Forwarded-Proto (Railway/ingress privé).
BOB_LIVE_GATEWAY_TLS_MODE=direct
BOB_LIVE_AUDIT_PROVIDER=local-whisper
# Sidecar loopback compatible OpenAI multipart. Toute destination réseau distante est refusée.
BOB_LIVE_LOCAL_AUDIT_BASE_URL=http://127.0.0.1:8080/v1
BOB_LIVE_LOCAL_AUDIT_TOKEN=

# Transport + voix Voxtral (actifs uniquement avec BOB_LIVE_PROVIDER=mistral).
MISTRAL_API_KEY=
MISTRAL_REALTIME_STT_MODEL=voxtral-mini-transcribe-realtime-2602
MISTRAL_REALTIME_BASE_URL=wss://api.mistral.ai
MISTRAL_REALTIME_TARGET_DELAY_MS=240
# URL publique figée du gateway Bob (jamais construite depuis Host/X-Forwarded-* non fiables).
BOB_LIVE_MISTRAL_WEBSOCKET_URL=ws://127.0.0.1:3000/v1/voice/realtime/mistral

# Transport + voix OpenAI (actifs uniquement avec BOB_LIVE_PROVIDER=openai).
# Les alias OPENAI_REALTIME_* historiques restent compris pendant la migration.
OPENAI_REALTIME_ENABLED=false
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin
OPENAI_TTS_MODEL=gpt-4o-mini-tts-2025-12-15
OPENAI_REALTIME_BASE_URL=https://api.openai.com/v1
OPENAI_REALTIME_PROVIDER_TIMEOUT_MS=4000
# Le SDP n'est rendu au mobile qu'une fois le canal de contrôle serveur prêt.
OPENAI_REALTIME_SIDEBAND_TIMEOUT_MS=3000
# Garde coût/confidentialité, également appliquée sur le mobile (maximum 15 minutes).
OPENAI_REALTIME_MAX_SESSION_SECONDS=900
# HMAC distinct du JWT et des autres secrets ; 32 caractères minimum. Requis seulement si Bob Live est activé.
OPENAI_REALTIME_SAFETY_SECRET=
# Clé HMAC indépendante pour les preuves acoustiques (rotation via la version ci-dessous).
OPENAI_REALTIME_PROOF_SECRET=
OPENAI_REALTIME_PROOF_KEY_VERSION=1
OPENAI_REALTIME_CONTROL_ENCRYPTION_SECRET=
OPENAI_REALTIME_CONTROL_ENCRYPTION_KEY_VERSION=1
# Quotas glissants durables (les tentatives admises restent consommées si le provider échoue).
OPENAI_REALTIME_MAX_CALLS_PER_MINUTE=3
OPENAI_REALTIME_MAX_CALLS_PER_HOUR=30
OPENAI_REALTIME_MAX_TENANT_CALLS_PER_MINUTE=50
OPENAI_REALTIME_MAX_TENANT_CALLS_PER_HOUR=1000
# Machine de bail distribuée : bootstrap 15 s, heartbeat 10 s sur bail actif 30 s.
OPENAI_REALTIME_RESERVATION_TTL_SECONDS=15
OPENAI_REALTIME_ACTIVE_LEASE_SECONDS=30
OPENAI_REALTIME_HEARTBEAT_SECONDS=10
OPENAI_REALTIME_REAPER_LEASE_SECONDS=30
AI_ROUTER_DEFAULT=claude

# CORS browser en production : liste explicite des fronts autorisés.
# Les apps mobiles natives et appels server-to-server sans header Origin restent autorisés.
CORS_ORIGINS=https://app.bobpro.fr

# Voix cloud. Par défaut, si MISTRAL_API_KEY est présent, Bob utilise Voxtral STT.
# L'audio brut n'est pas persisté : transcription serveur -> texte seulement.
STT_PROVIDER=mistral
MISTRAL_STT_MODEL=voxtral-mini-latest
# Lexique métier optionnel, séparé par virgules : clients, fournisseurs, refs factures, SIRET, etc.
MISTRAL_STT_CONTEXT_BIAS=
MISTRAL_TTS_MODEL=voxtral-mini-tts-2603
MISTRAL_TTS_VOICE_ID=

# Paiement live : aucun lien factice n'est émis lorsque DEMO_MODE=false.
STRIPE_SECRET_KEY=
STRIPE_PRICE_SOLO=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
# Secret propre à l'endpoint Workbench (différent de celui du Stripe CLI).
STRIPE_WEBHOOK_SECRET=
# `true` en production Stripe live ; `false` uniquement pour staging/sandbox.
STRIPE_LIVEMODE=true
PAYMENT_RETURN_BASE_URL=https://app.bobpro.fr

# Base de données — projet Supabase « bob-pro » (eu-west-3). Schéma Prisma + RLS (FORCE + policies) appliqués.
#
# DEUX rôles — la RLS runtime EXIGE un rôle NON-superuser (le rôle postgres BYPASSE la RLS) :
#  - DATABASE_URL : runtime = rôle applicatif « bob_app » (NON-superuser, soumis à FORCE RLS).
#                   C'est lui qui fait mordre l'isolation multi-tenant (certifié sur la vraie base :
#                   lecture scopée + écriture cross-tenant bloquée par WITH CHECK). MDP dans apps/api/.env (local).
#  - DIRECT_URL   : migrations + seed = rôle « postgres » (privilégié). MDP dans le dashboard (Settings > Database).
#
# Release/CD :
#  - APP_DATABASE_ROLE : nom du rôle runtime à grant avant RLS/certification.
#  - RUN_RLS_CERT=true : bloque la release si DATABASE_URL n'est pas un rôle applicatif soumis à RLS.
#  - RLS_CERT_CLEANUP=true : supprime les fixtures rls-* avant/après la certification.
#  - apps/api/scripts/check-release-env.sh : gate CI sans affichage de secrets.
APP_DATABASE_ROLE=bob_app
RUN_RLS_CERT=true
RLS_CERT_CLEANUP=true
# Alertes live recommandées : oldest_encrypted_seconds > 259200 (72 h) OU
# time() - cabinet_invitation_worker_last_success_unixtime > 300 (worker muet 5 min).
#
# Connexion DIRECTE (5432) : l'app fait des transactions interactives + SELECT ... FOR UPDATE
# (le pooler transaction-mode 6543 ne les supporte pas). Alternative IPv4 : pooler session-mode
# (aws-0-eu-west-3.pooler.supabase.com:5432, user « bob_app.cvdkqjczgqoeshputacl »).
DATABASE_URL=postgresql://bob_app:[MOT_DE_PASSE_BOB_APP]@db.cvdkqjczgqoeshputacl.supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:[MOT_DE_PASSE_DB]@db.cvdkqjczgqoeshputacl.supabase.co:5432/postgres

# Auth Supabase (prod) — validation JWT via JWKS (clés asymétriques ES256 du projet bob-pro).
SUPABASE_JWKS_URL=https://cvdkqjczgqoeshputacl.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUD=authenticated

# Storage documentaire privé — les fichiers ne sont jamais servis directement depuis le mobile.
# L'API écrit avec la service-role key, garde les métadonnées en Postgres/RLS, et renvoie seulement des URLs signées courtes.
SUPABASE_URL=https://cvdkqjczgqoeshputacl.supabase.co
SUPABASE_SERVICE_ROLE_KEY=[SERVICE_ROLE_KEY]
SUPABASE_STORAGE_BUCKET=bob-documents
SUPABASE_REALTIME_AUDIO_BUCKET=bob-live-audio

# Workers planifiés (relances, archive documents, outbox notifications).
# En prod avec RLS runtime, liste explicitement les tenants à traiter tant qu'un répertoire
# service-role dédié n'existe pas. En démo, vide = fallback sur les sociétés in-memory.
JOB_COMPANY_IDS=

# Espace Cabinet — release fail-closed et outbox invitations.
CABINET_RELEASE_ENV=development
# Secret AEAD >= 32 caractères, à générer et stocker dans le provider (jamais committer la valeur réelle).
CABINET_INVITATION_TOKEN_ENCRYPTION_KEY=[SECRET_AEAD_32_CARACTERES_MINIMUM]
CABINET_INVITATION_TOKEN_KEY_VERSION=1
CABINET_INVITATION_WEB_BASE_URL=https://cabinet.bobpro.fr
# Le worker est une identité Supabase avec membership active dans chaque cabinet listé.
CABINET_INVITATION_WORKER_ENABLED=false
JOB_CABINET_IDS=
CABINET_INVITATION_WORKER_USER_ID=
# Premier deploiement pilote uniquement : JSON secret du provider, jamais logge ni committe.
# Les cabinetId doivent former exactement le meme ensemble que JOB_CABINET_IDS (100 maximum).
# CABINET_PILOT_BOOTSTRAP_CONFIG=[{"cabinetId":"11111111-1111-4111-8111-111111111111","name":"Cabinet pilote","timeZone":"Europe/Paris","founderUserId":"22222222-2222-4222-8222-222222222222","expectedFlagVersion":1,"actor":"release-ops","reason":"Ouverture du pilote approuvee"}]

# Scrape Prometheus live : Authorization Bearer <METRICS_TOKEN>.
METRICS_TOKEN=[SECRET_METRICS_32_CARACTERES_MINIMUM]

# Reporter HTTP sanitisé (type d'erreur + correlationId, sans message/stack/PII).
ERROR_REPORTER_WEBHOOK_URL=

# Email transactionnel (M3 sortant) — Brevo seulement côté serveur.
# Sans ces valeurs, l'API utilise DemoNotifier (audit local, aucun email réel).
BREVO_API_KEY=
BREVO_API_BASE_URL=https://api.brevo.com/v3
BREVO_SENDER_EMAIL=hello@bobpro.fr
BREVO_SENDER_NAME=Bob Pro
SIGN_WEB_BASE_URL=https://signature.bobpro.fr
