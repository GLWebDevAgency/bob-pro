# Bob Pro API — variables d'environnement
NODE_ENV=development
PORT=3000

# Mode démo : in-memory, sans base ni clé. Passe à "false" pour la prod (Postgres + JWT + LLM).
DEMO_MODE=true

# IA (clés JAMAIS sur le device — uniquement ici). Sans clé -> routeur en mode démo déterministe.
ANTHROPIC_API_KEY=
GLM_API_KEY=
AI_ROUTER_DEFAULT=claude

# Base de données — projet Supabase « bob-pro » (eu-west-3). Schéma Prisma + RLS DÉJÀ appliqués.
# Récupère le mot de passe DB dans le dashboard Supabase (Settings > Database), colle la
# connection string du pooler ci-dessous. Le rôle postgres bypasse la RLS ; les politiques
# protègent l'accès PostgREST via la clé anon publique.
DATABASE_URL=postgresql://postgres.cvdkqjczgqoeshputacl:[MOT_DE_PASSE_DB]@aws-0-eu-west-3.pooler.supabase.com:6543/postgres

# Auth Supabase (prod) — validation JWT via JWKS (clés asymétriques ES256 du projet bob-pro).
SUPABASE_JWKS_URL=https://cvdkqjczgqoeshputacl.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUD=authenticated
