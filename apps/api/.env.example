# Bob Pro API — variables d'environnement
NODE_ENV=development
PORT=3000

# Mode démo : in-memory, sans base ni clé. Passe à "false" pour la prod (Postgres + JWT + LLM).
DEMO_MODE=true

# IA (clés JAMAIS sur le device — uniquement ici). Sans clé -> routeur en mode démo déterministe.
ANTHROPIC_API_KEY=
GLM_API_KEY=
AI_ROUTER_DEFAULT=claude

# Base de données (prochain incrément : adapters Prisma/Postgres)
DATABASE_URL=postgresql://user:pass@localhost:5432/bobpro?schema=public

# Auth Supabase (prod) — validation JWT via JWKS
SUPABASE_JWKS_URL=
