# Bob Pro API — variables d'environnement
NODE_ENV=development
PORT=3000

# Mode démo : in-memory, sans base ni clé. Passe à "false" pour la prod (Postgres + JWT + LLM).
DEMO_MODE=true

# IA (clés JAMAIS sur le device — uniquement ici). Sans clé -> routeur en mode démo déterministe.
ANTHROPIC_API_KEY=
GLM_API_KEY=
AI_ROUTER_DEFAULT=claude

# Base de données. Multi-tenant : en prod, connecter via un rôle NON-superuser (ex. bob_app)
# et appliquer les politiques RLS : psql "$DATABASE_URL" -f prisma/rls.sql
# (l'app pose app.current_company_id par requête via PrismaService.withTenant).
DATABASE_URL=postgresql://bob_app:pass@localhost:5432/bobpro?schema=public

# Auth Supabase (prod) — validation JWT via JWKS
SUPABASE_JWKS_URL=
