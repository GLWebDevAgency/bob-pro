{
  "name": "@bob/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3010",
    "build": "pnpm --filter @bob/core build && pnpm --filter @bob/i18n build && pnpm --filter @bob/tokens build && next build",
    "start": "next start -p 3010",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e:staging": "playwright test --config=playwright.config.ts",
    "lint": "eslint . --ext .ts,.tsx --env browser"
  },
  "dependencies": {
    "@bob/core": "workspace:*",
    "@bob/i18n": "workspace:*",
    "@bob/tokens": "workspace:*",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "next": "^16.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "^22.13.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.6.3"
  }
}
