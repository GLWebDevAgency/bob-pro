# Bob Pro — variables publiques Expo (inlinées dans le bundle, préfixe EXPO_PUBLIC_).

# Backend : si défini -> HttpBobClient (NestJS réel) ; sinon LocalBobClient (démo hors-ligne).
EXPO_PUBLIC_API_URL=
# Tenant courant (en-tête x-company-id en mode démo backend). Défaut : company-mercier.
EXPO_PUBLIC_COMPANY_ID=company-mercier

# Auth réelle : Supabase. Si les deux sont fournis -> écran de login obligatoire (mode connecté).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Jeton statique optionnel (dev, contre un backend non-démo) si pas de session Supabase.
EXPO_PUBLIC_API_TOKEN=
