{
  "expo": {
    "name": "Bob Pro",
    "slug": "bob-pro",
    "scheme": "bobpro",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#0C2340"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Bob accède à tes photos pour scanner tes factures et tickets fournisseurs.",
          "cameraPermission": "Bob utilise l'appareil photo pour scanner tes factures et tickets fournisseurs."
        }
      ],
      "expo-speech-recognition",
      "expo-audio",
      "expo-sharing"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "fr.bobpro.app"
    },
    "android": {
      "package": "fr.bobpro.app"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
