{
  "name": "@bob/ai",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "require": "./dist/index.cjs" },
    "./testing": {
      "types": "./dist-testing/testing.d.ts",
      "import": "./dist-testing/testing.js",
      "require": "./dist-testing/testing.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --external @bob/core --clean && node scripts/assert-production-artifact.mjs",
    "build:testing": "tsup src/testing.ts --format esm,cjs --dts --external @bob/core --out-dir dist-testing --clean",
    "artifact:verify": "node scripts/assert-production-artifact.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@bob/core": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.6"
  }
}
